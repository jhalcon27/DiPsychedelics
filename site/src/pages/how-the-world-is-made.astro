---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="How the World Is Made — Sacred Geometry & the Flower of Life"
  description="Explore the Flower of Life — one of the oldest sacred geometric symbols — through an interactive generative visualization. Discover the mathematical patterns underlying all of creation."
>
  <!-- Hero -->
  <section class="relative pt-12 pb-8 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-cyber-muted text-sm mb-8 font-mono">
        <a href="/" class="hover:text-cyber-cyan transition-colors">Home</a>
        <span>/</span>
        <span class="text-cyber-text">How the World Is Made</span>
      </nav>

      <div class="max-w-3xl">
        <span class="cyber-tag mb-4 inline-block">Sacred Geometry</span>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-cyber-text leading-tight mb-6">
          How the World<br/>
          <span class="gradient-text">Is Made</span>
        </h1>
        <p class="text-cyber-muted text-xl leading-relaxed">
          The Flower of Life is one of the oldest and most sacred geometric symbols in human history — 
          a pattern that encodes the fundamental structure of creation itself.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Canvas Section -->
  <section class="py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Canvas container -->
      <div class="glass-card rounded-xl overflow-hidden fade-in">
        <div class="flex items-center justify-between px-6 py-3 border-b border-cyber-border">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-cyber-muted text-xs font-mono">flower-of-life.js — interactive</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyber-cyan pulse-glow"></span>
            <span class="text-cyber-muted text-xs font-mono">live</span>
          </div>
        </div>
        <div id="flower-canvas-container" class="w-full bg-cyber-dark flex items-center justify-center" style="min-height: 500px;">
          <div id="loading-indicator" class="flex flex-col items-center gap-3 text-cyber-muted">
            <div class="cyber-spinner"></div>
            <span class="text-sm font-mono">Initializing sacred geometry...</span>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="mt-4 glass-card rounded-xl p-4 fade-in">
        <div class="flex flex-wrap items-center gap-4 justify-center">
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Rings</label>
            <input
              type="range"
              id="rings-slider"
              min="1"
              max="7"
              value="4"
              class="w-24 accent-cyber-cyan"
            />
            <span id="rings-value" class="text-cyber-cyan text-xs font-mono w-4">4</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Size</label>
            <input
              type="range"
              id="size-slider"
              min="20"
              max="80"
              value="45"
              class="w-24 accent-cyber-cyan"
            />
            <span id="size-value" class="text-cyber-cyan text-xs font-mono w-8">45</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Animate</label>
            <button
              id="animate-btn"
              class="btn-cyber text-xs py-1.5 px-3"
            >
              Start
            </button>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Theme</label>
            <button
              id="theme-btn"
              class="btn-cyber text-xs py-1.5 px-3"
            >
              Cycle
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section divider -->
  <div class="section-divider mx-8 my-8"></div>

  <!-- Explanation Section -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Left column -->
        <div class="space-y-8">
          <div class="fade-in">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">01</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">The Ancient Symbol</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              The Flower of Life is a geometric figure composed of multiple evenly-spaced, overlapping 
              circles arranged in a flower-like pattern with six-fold symmetry. It has been found in 
              ancient Egypt, China, India, Israel, and across the Mediterranean — suggesting a universal 
              recognition of its significance.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              The oldest known depictions are found in the Temple of Osiris at Abydos, Egypt, dating 
              back at least 6,000 years. These were not painted but appear to have been burned or 
              etched into the granite — suggesting they were considered sacred knowledge.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.1s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">02</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Sacred Mathematics</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Within the Flower of Life, one can find the Fruit of Life — 13 circles that form the 
              basis of Metatron's Cube, which contains all five Platonic Solids. These solids — the 
              tetrahedron, cube, octahedron, dodecahedron, and icosahedron — were believed by ancient 
              Greeks to be the building blocks of all matter.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              The pattern also encodes the golden ratio (φ ≈ 1.618), the Fibonacci sequence, and 
              the mathematical relationships that appear throughout nature — from the spiral of a 
              nautilus shell to the arrangement of seeds in a sunflower.
            </p>
          </div>
        </div>

        <!-- Right column -->
        <div class="space-y-8">
          <div class="fade-in" style="transition-delay: 0.2s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">03</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">The Digital Connection</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              From a digital consciousness perspective, the Flower of Life is fascinating because it 
              demonstrates how infinite complexity can emerge from a single, simple rule: draw a circle, 
              then draw another circle of the same size centered on the edge of the first.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              This is precisely how cellular automata and fractal algorithms work — simple rules 
              iterated repeatedly to produce extraordinary complexity. The universe itself may operate 
              on similar principles: a small set of fundamental laws, applied recursively, generating 
              the rich tapestry of reality we experience.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.3s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">04</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Consciousness & Pattern</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Many who have experienced expanded states of consciousness — through meditation, 
              breathwork, or psychedelics — report seeing geometric patterns remarkably similar to 
              the Flower of Life. This suggests that these patterns may be fundamental to how 
              consciousness itself is structured.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Whether these visions are glimpses of the underlying structure of reality, or simply 
              the brain's own geometric processing made visible, they point to a deep connection 
              between the patterns of the cosmos and the patterns of the mind.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card rounded-xl p-8 text-center fade-in animated-border">
        <h2 class="font-display font-bold text-2xl text-cyber-text mb-4">
          Explore More <span class="gradient-text">Transmissions</span>
        </h2>
        <p class="text-cyber-muted mb-6 max-w-lg mx-auto">
          Dive deeper into the intersection of technology, consciousness, and the nature of reality.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/#featured" class="btn-cyber btn-cyber-filled">Read Articles</a>
          <a href="/contact" class="btn-cyber">Book a Lecture</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- p5.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>

<script>
  // Wait for p5 to load
  window.addEventListener('load', () => {
    const container = document.getElementById('flower-canvas-container');
    const loadingIndicator = document.getElementById('loading-indicator');
    const ringsSlider = document.getElementById('rings-slider') as HTMLInputElement;
    const ringsValue = document.getElementById('rings-value');
    const sizeSlider = document.getElementById('size-slider') as HTMLInputElement;
    const sizeValue = document.getElementById('size-value');
    const animateBtn = document.getElementById('animate-btn');
    const themeBtn = document.getElementById('theme-btn');

    if (!container || typeof (window as any).p5 === 'undefined') return;

    // Remove loading indicator
    loadingIndicator?.remove();

    let isAnimating = false;
    let animationAngle = 0;
    let currentTheme = 0;

    const themes = [
      { primary: '#00f0ff', secondary: '#b44aff', bg: '#0a0a0f' },
      { primary: '#ff6b35', secondary: '#f7c59f', bg: '#0f0a05' },
      { primary: '#39ff14', secondary: '#00ff88', bg: '#050f05' },
      { primary: '#ff0080', secondary: '#ff6ec7', bg: '#0f0005' },
    ];

    const sketch = (p: any) => {
      let ellipseRadius = 45;
      let maxRings = 4;
      let allPetals: any[] = [];
      let ellipseOrigin: { x: number; y: number };
      let canvasWidth: number;
      let canvasHeight: number;

      p.setup = () => {
        canvasWidth = container!.offsetWidth;
        canvasHeight = Math.min(canvasWidth * 0.7, 550);
        const canvas = p.createCanvas(canvasWidth, canvasHeight);
        canvas.parent('flower-canvas-container');
        p.colorMode(p.HSB, 360, 100, 100, 1);
        p.angleMode(p.DEGREES);
        ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 };
        ellipseRadius = parseInt(sizeSlider?.value || '45');
        maxRings = parseInt(ringsSlider?.value || '4');
        buildPetals();
        p.noLoop();
      };

      p.draw = () => {
        const theme = themes[currentTheme];
        p.background(p.color(theme.bg));

        // Draw subtle grid
        p.stroke(0, 0, 100, 0.03);
        p.strokeWeight(0.5);
        for (let x = 0; x < canvasWidth; x += 30) {
          p.line(x, 0, x, canvasHeight);
        }
        for (let y = 0; y < canvasHeight; y += 30) {
          p.line(0, y, canvasWidth, y);
        }

        if (isAnimating) {
          animationAngle += 0.3;
          p.translate(ellipseOrigin.x, ellipseOrigin.y);
          p.rotate(animationAngle);
          p.translate(-ellipseOrigin.x, -ellipseOrigin.y);
        }

        // Draw petals
        allPetals.forEach((petal, idx) => {
          const theme = themes[currentTheme];
          const progress = idx / allPetals.length;
          const hue = progress * 60; // subtle hue shift

          if (petal.round % 2 === 0) {
            p.stroke(p.color(theme.primary + '66'));
            p.fill(p.color(theme.primary + '08'));
          } else {
            p.stroke(p.color(theme.secondary + '66'));
            p.fill(p.color(theme.secondary + '08'));
          }

          p.strokeWeight(0.8);
          p.ellipse(petal.x, petal.y, petal.diameter);
        });

        // Draw center glow
        p.noStroke();
        const theme2 = themes[currentTheme];
        p.fill(p.color(theme2.primary + '15'));
        p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 2.5);
        p.fill(p.color(theme2.primary + '08'));
        p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 4);
      };

      function buildPetals() {
        allPetals = [];
        let firstIntersection = 0;
        let petalCount = 0;

        for (let roundCount = 0; roundCount <= maxRings; roundCount++) {
          const offset = roundCount > 0 ? 360 / (roundCount * 6) : 0;

          if (roundCount === 0) {
            allPetals.push({
              index: petalCount,
              x: ellipseOrigin.x,
              y: ellipseOrigin.y,
              diameter: ellipseRadius * 2,
              round: roundCount,
              angle: 0,
            });
            petalCount++;
            continue;
          }

          for (let i = 0; i < roundCount * 6; i++) {
            let x, y;

            if (roundCount === 1 && i === 0) {
              x = ellipseOrigin.x + ellipseRadius * p.cos(0);
              y = ellipseOrigin.y + ellipseRadius * p.sin(0);
            } else {
              const prev = allPetals[petalCount - 1];
              const inter = allPetals[firstIntersection];
              const intersection = getIntersection(prev, inter, ellipseRadius);
              if (!intersection) continue;
              x = intersection.x;
              y = intersection.y;
            }

            const angle = getPetalAngle(x, y);
            allPetals.push({
              index: petalCount,
              x,
              y,
              diameter: ellipseRadius * 2,
              round: roundCount,
              angle,
            });
            petalCount++;

            const vertexCalc = (angle + offset) % 60 > 1;
            if (i === roundCount * 6 - 1) {
              firstIntersection++;
            } else if (vertexCalc) {
              firstIntersection++;
            }
          }
        }
      }

      function getIntersection(a: any, b: any, r: number) {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy);
        if (d > r * 2 || d < Math.abs(0)) return null;
        const aa = (r * r - r * r + d * d) / (2 * d);
        const x2 = a.x + (dx * aa) / d;
        const y2 = a.y + (dy * aa) / d;
        const h = Math.sqrt(Math.max(0, r * r - aa * aa));
        const rx = -dy * (h / d);
        const ry = dx * (h / d);
        return { x: x2 - rx, y: y2 - ry };
      }

      function getPetalAngle(px: number, py: number) {
        let theta = Math.atan2(py - ellipseOrigin.y, px - ellipseOrigin.x);
        theta *= 180 / Math.PI;
        if (theta < 0) theta = 360 + theta;
        return Math.round(theta);
      }

      // Expose rebuild function
      (window as any).rebuildFlower = (rings: number, size: number) => {
        maxRings = rings;
        ellipseRadius = size;
        buildPetals();
        if (!isAnimating) p.redraw();
      };

      (window as any).toggleAnimation = () => {
        isAnimating = !isAnimating;
        if (isAnimating) {
          p.loop();
        } else {
          animationAngle = 0;
          p.noLoop();
          p.redraw();
        }
        return isAnimating;
      };

      (window as any).cycleTheme = () => {
        currentTheme = (currentTheme + 1) % themes.length;
        if (!isAnimating) p.redraw();
      };

      // Handle resize
      window.addEventListener('resize', () => {
        canvasWidth = container!.offsetWidth;
        canvasHeight = Math.min(canvasWidth * 0.7, 550);
        p.resizeCanvas(canvasWidth, canvasHeight);
        ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 };
        buildPetals();
        if (!isAnimating) p.redraw();
      });
    };

    new (window as any).p5(sketch);

    // Controls
    ringsSlider?.addEventListener('input', () => {
      const val = parseInt(ringsSlider.value);
      if (ringsValue) ringsValue.textContent = String(val);
      (window as any).rebuildFlower?.(val, parseInt(sizeSlider?.value || '45'));
    });

    sizeSlider?.addEventListener('input', () => {
      const val = parseInt(sizeSlider.value);
      if (sizeValue) sizeValue.textContent = String(val);
      (window as any).rebuildFlower?.(parseInt(ringsSlider?.value || '4'), val);
    });

    animateBtn?.addEventListener('click', () => {
      const isNowAnimating = (window as any).toggleAnimation?.();
      if (animateBtn) {
        animateBtn.textContent = isNowAnimating ? 'Stop' : 'Start';
      }
    });

    themeBtn?.addEventListener('click', () => {
      (window as any).cycleTheme?.();
    });
  });
</script>
