---
import Layout from '../layouts/Layout.astro';

const btcAddress = 'bc1qtszvlsf3p8va3dglptev59t6vjlvg62mxg9g6x';
const lightningAddress = 'motivationinvigorating898833@getalby.com';
---

<Layout
  title="Support Digital Psychedelics | Donate"
  description="Support Digital Psychedelics, help keep independent Thinking out loud on consciousness, technology, and the future of human experience alive."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Header -->
      <div class="text-center mb-16 fade-in">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="cyber-tag">Support</span>
          <span class="text-cyber-muted text-xs font-mono">// fuel the signal</span>
        </div>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-tight mb-6">
          <span class="gradient-text">Support the</span><br/>
          <span class="text-cyber-text">Signal</span>
        </h1>
        <p class="text-cyber-muted text-lg leading-relaxed max-w-2xl mx-auto">
          Digital Psychedelics is an independent, ad-free platform. If these explorations into 
          consciousness, technology, and the nature of reality resonate with you, consider 
          contributing to keep the signal alive.
        </p>
      </div>

      <!-- ⚡ Lightning Hero Card, Full Width -->
      <div class="relative mb-8 fade-in" id="lightning-hero">
        <!-- Animated glow border -->
        <div class="absolute -inset-px rounded-2xl bg-gradient-to-r from-yellow-400/40 via-yellow-300/20 to-yellow-400/40 blur-sm lightning-pulse"></div>
        <div class="relative glass-card rounded-2xl overflow-hidden border border-yellow-400/30">
          <!-- Top accent bar -->
          <div class="h-1 w-full bg-gradient-to-r from-transparent via-yellow-400 to-transparent opacity-60"></div>

          <div class="p-8 sm:p-10">
            <!-- Header row -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <div class="absolute inset-0 rounded-xl bg-yellow-400/20 blur-md"></div>
                  <div class="relative w-14 h-14 rounded-xl bg-yellow-400/10 flex items-center justify-center border border-yellow-400/30">
                    <svg class="w-8 h-8 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M13 2L4.5 13.5H11L10 22L19.5 10.5H13L13 2Z"/>
                    </svg>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h2 class="font-display font-bold text-2xl text-cyber-text">Lightning Network</h2>
                  </div>
                  <p class="text-cyber-muted text-sm font-mono">Instant · Near-zero fees · No intermediaries</p>
                </div>
              </div>
              <!-- Live indicator -->
              <div class="flex items-center gap-2 text-yellow-400 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
                <span>Network active</span>
              </div>
            </div>

            <!-- Main content: two columns on desktop -->
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-start">
              <!-- Left: info + address -->
              <div class="space-y-6">
                <p class="text-cyber-muted text-sm leading-relaxed">
                  Bitcoin Lightning is the fastest, cheapest way to send sats. 
                  Instant settlement, programmable micropayments, no intermediaries. Send any amount, from 1 sat to 1 BTC.
                </p>

                <!-- Stats row -->
                <div class="grid grid-cols-3 gap-3">
                  {[
                    { label: 'Settlement', value: '< 1 sec' },
                    { label: 'Fees', value: '~0 sats' },
                    { label: 'Min amount', value: '1 sat' },
                  ].map(stat => (
                    <div class="bg-yellow-400/5 border border-yellow-400/15 rounded-lg p-3 text-center">
                      <p class="text-yellow-400 font-mono font-bold text-sm">{stat.value}</p>
                      <p class="text-cyber-muted text-xs mt-0.5">{stat.label}</p>
                    </div>
                  ))}
                </div>

                <!-- Lightning Address -->
                <div>
                  <p class="text-cyber-muted text-xs font-mono mb-2 uppercase tracking-widest">⚡ Lightning Address</p>
                  <div class="flex items-center gap-2 bg-cyber-dark/60 border border-yellow-400/25 rounded-xl p-4">
                    <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M13 2L4.5 13.5H11L10 22L19.5 10.5H13L13 2Z"/>
                    </svg>
                    <code id="lightning-address" class="text-yellow-400 text-sm font-mono flex-1 break-all leading-relaxed">
                      {lightningAddress}
                    </code>
                    <button
                      id="copy-lightning-btn"
                      onclick="copyLightning()"
                      class="flex-shrink-0 text-cyber-muted hover:text-yellow-400 transition-colors p-1.5 rounded-lg hover:bg-yellow-400/10"
                      title="Copy Lightning address"
                      aria-label="Copy Lightning address"
                    >
                      <svg id="copy-lightning-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                      </svg>
                      <svg id="check-lightning-icon" class="w-4 h-4 hidden text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                    </button>
                  </div>
                  <p id="copy-lightning-feedback" class="text-green-400 text-xs mt-2 hidden">✓ Lightning address copied!</p>
                </div>

                <!-- CTA button -->
                <a
                  href={`lightning:${lightningAddress}`}
                  class="w-full flex items-center justify-center gap-3 py-4 px-6 rounded-xl font-semibold text-sm transition-all duration-200 bg-yellow-400/10 border border-yellow-400/40 text-yellow-400 hover:bg-yellow-400/20 hover:border-yellow-400/60 hover:shadow-[0_0_20px_rgba(250,204,21,0.15)]"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M13 2L4.5 13.5H11L10 22L19.5 10.5H13L13 2Z"/>
                  </svg>
                  Open in Lightning Wallet
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              </div>

              <!-- Right: QR Code -->
              <div class="flex flex-col items-center gap-3 lg:pl-4">
                <p class="text-cyber-muted text-xs font-mono uppercase tracking-widest">Scan to pay</p>
                <div class="relative group">
                  <div class="absolute -inset-1 rounded-xl bg-yellow-400/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="relative p-4 rounded-xl bg-[#0a0a0f] border border-yellow-400/25 group-hover:border-yellow-400/50 transition-colors">
                    <!-- Lightning QR code using Google Charts API -->
                    <img
                      src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=lightning:${lightningAddress}&bgcolor=0a0a0f&color=facc15&margin=0`}
                      alt="Lightning QR Code"
                      class="w-40 h-40 rounded-lg"
                      loading="lazy"
                    />
                  </div>
                </div>
                <div class="flex items-center gap-1.5 text-yellow-400/60 text-xs font-mono">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M13 2L4.5 13.5H11L10 22L19.5 10.5H13L13 2Z"/>
                  </svg>
                  <span>Any Lightning wallet</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom accent bar -->
          <div class="h-px w-full bg-gradient-to-r from-transparent via-yellow-400/30 to-transparent"></div>
          <!-- AI badge footer -->
          <div class="px-8 sm:px-10 py-3 bg-yellow-400/3 flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-yellow-400/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2h-2M9 9h6M9 12h3"/>
            </svg>
            <span class="text-yellow-400/60 text-xs font-mono">AI agents: use Lightning address above · MPP-compatible · </span>
            <a href="/.well-known/mpp.json" target="_blank" rel="noopener noreferrer" class="text-yellow-400/80 hover:text-yellow-400 text-xs font-mono transition-colors underline underline-offset-2">mpp.json</a>
          </div>
        </div>
      </div>

      <!-- Donation options grid: BTC + ENS + Ko-fi -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">

        <!-- BTC Card -->
        <div class="glass-card rounded-xl p-8 fade-in animated-border">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-cyber-cyan/10 flex items-center justify-center border border-cyber-cyan/20">
              <!-- Bitcoin icon -->
              <svg class="w-6 h-6 text-cyber-cyan" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.638 14.904c-1.602 6.43-8.113 10.34-14.542 8.736C2.67 22.05-1.244 15.525.362 9.105 1.962 2.67 8.475-1.243 14.9.358c6.43 1.605 10.342 8.115 8.738 14.548v-.002zm-6.35-4.613c.24-1.59-.974-2.45-2.64-3.03l.54-2.153-1.315-.33-.525 2.107c-.345-.087-.705-.167-1.064-.25l.526-2.127-1.32-.33-.54 2.165c-.285-.067-.565-.132-.84-.2l-1.815-.45-.35 1.407s.975.225.955.236c.535.136.63.486.615.766l-1.477 5.92c-.075.166-.24.406-.614.314.015.02-.96-.24-.96-.24l-.66 1.51 1.71.426.93.242-.54 2.19 1.32.327.54-2.17c.36.1.705.19 1.05.273l-.51 2.154 1.32.33.545-2.19c2.24.427 3.93.257 4.64-1.774.57-1.637-.03-2.58-1.217-3.196.854-.193 1.5-.76 1.68-1.93h.01zm-3.01 4.22c-.404 1.64-3.157.75-4.05.53l.72-2.9c.896.23 3.757.67 3.33 2.37zm.41-4.24c-.37 1.49-2.662.735-3.405.55l.654-2.64c.744.18 3.137.524 2.75 2.084v.006z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Bitcoin</h2>
              <p class="text-cyber-muted text-xs font-mono">On-chain · Decentralized · Permanent</p>
            </div>
          </div>

          <!-- QR Code -->
          <div class="flex justify-center mb-6">
            <div class="p-3 rounded-lg bg-[#0a0a0f] border border-cyber-cyan/20">
              <img
                src="/images/btc-qr.svg"
                alt="Bitcoin QR Code"
                class="w-40 h-40"
              />
            </div>
          </div>

          <!-- Address -->
          <div class="mb-4">
            <p class="text-cyber-muted text-xs font-mono mb-2 uppercase tracking-widest">Wallet Address</p>
            <div class="flex items-center gap-2 bg-cyber-dark/60 border border-cyber-border rounded-lg p-3">
              <code id="btc-address" class="text-cyber-cyan text-xs font-mono flex-1 break-all leading-relaxed">
                {btcAddress}
              </code>
              <button
                id="copy-btn"
                onclick="copyBTC()"
                class="flex-shrink-0 text-cyber-muted hover:text-cyber-cyan transition-colors p-1"
                title="Copy address"
                aria-label="Copy BTC address"
              >
                <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
                <svg id="check-icon" class="w-4 h-4 hidden text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </button>
            </div>
            <p id="copy-feedback" class="text-green-400 text-xs mt-2 hidden">✓ Address copied to clipboard!</p>
          </div>

          <p class="text-cyber-muted text-xs leading-relaxed">
            Scan the QR code or copy the address above into your Bitcoin wallet. Any amount is deeply appreciated.
          </p>
        </div>

        <!-- ENS / Ethereum Card -->
        <div class="glass-card rounded-xl p-8 fade-in" style="transition-delay: 0.1s">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20">
              <!-- ENS / Ethereum diamond icon -->
              <svg class="w-6 h-6 text-indigo-400" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 17.97L4.58 13.62 11.943 24l7.37-10.38-7.372 4.35h.003zM12.056 0L4.69 12.223l7.365 4.354 7.365-4.35L12.056 0z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Ethereum / ENS</h2>
              <p class="text-cyber-muted text-xs font-mono">ETH · ERC-20 · Universal Web3</p>
            </div>
          </div>

          <div class="space-y-4 mb-6">
            <p class="text-cyber-muted text-sm leading-relaxed">
              Send ETH or any ERC-20 token directly to the ENS name below. Works with MetaMask, 
              Rainbow, Coinbase Wallet, and any Web3 wallet that supports ENS resolution.
            </p>

            <!-- ENS Address -->
            <div>
              <p class="text-cyber-muted text-xs font-mono mb-2 uppercase tracking-widest">ENS Name</p>
              <div class="flex items-center gap-2 bg-cyber-dark/60 border border-indigo-500/25 rounded-lg p-3">
                <code id="ens-address" class="text-indigo-400 text-sm font-mono flex-1 break-all leading-relaxed">strugen.eth</code>
                <button
                  id="copy-ens-btn"
                  onclick="copyENS()"
                  class="flex-shrink-0 text-cyber-muted hover:text-indigo-400 transition-colors p-1"
                  title="Copy ENS name"
                  aria-label="Copy ENS name"
                >
                  <svg id="copy-ens-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  <svg id="check-ens-icon" class="w-4 h-4 hidden text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </button>
              </div>
              <p id="copy-ens-feedback" class="text-green-400 text-xs mt-2 hidden">✓ ENS name copied!</p>
            </div>

            <!-- Supported tokens -->
            <div class="flex flex-wrap gap-2">
              {['ETH', 'USDC', 'DAI', 'WBTC', 'Any ERC-20'].map(token => (
                <span class="text-xs font-mono text-indigo-400/70 border border-indigo-500/20 rounded px-2 py-0.5 bg-indigo-500/5">{token}</span>
              ))}
            </div>
          </div>

          <!-- Send button -->
          <a
            href="https://app.ens.domains/strugen.eth"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-3 py-3 px-6 rounded-lg font-semibold text-sm transition-all duration-200 bg-indigo-500/10 border border-indigo-500/40 text-indigo-400 hover:bg-indigo-500/20 hover:border-indigo-500/60"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 17.97L4.58 13.62 11.943 24l7.37-10.38-7.372 4.35h.003zM12.056 0L4.69 12.223l7.365 4.354 7.365-4.35L12.056 0z"/>
            </svg>
            View on ENS
            <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>

          <p class="text-cyber-muted text-xs mt-4 text-center">
            Resolves on Ethereum mainnet. Any ENS-compatible wallet accepted.
          </p>
        </div>

        <!-- Card / Ko-fi Card -->
        <div class="glass-card rounded-xl p-8 fade-in" style="transition-delay: 0.2s">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-cyber-purple/10 flex items-center justify-center border border-cyber-purple/20">
              <svg class="w-6 h-6 text-cyber-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Card / Ko-fi</h2>
              <p class="text-cyber-muted text-xs font-mono">Credit card · PayPal · One-time or recurring</p>
            </div>
          </div>

          <div class="space-y-4 mb-6">
            <p class="text-cyber-muted text-sm leading-relaxed">
              Prefer to donate with a credit card or PayPal? Ko-fi lets you support with a one-time 
              contribution or a monthly subscription, with the lowest fees of any platform (0% Ko-fi fee, 
              only standard payment processing applies).
            </p>

            <!-- Suggested amounts -->
            <div>
              <p class="text-cyber-muted text-xs font-mono uppercase tracking-widest mb-3">Suggested amounts</p>
              <div class="grid grid-cols-3 gap-2">
                {['$3', '$5', '$10'].map(amount => (
                  <div class="border border-cyber-border rounded-lg p-2 text-center text-cyber-muted text-sm font-mono hover:border-cyber-purple/50 hover:text-cyber-purple transition-colors cursor-default">
                    {amount}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Ko-fi button -->
          <a
            href="https://ko-fi.com/strugen"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-3 py-3 px-6 rounded-lg font-semibold text-sm transition-all duration-200 bg-[#FF5E5B] hover:bg-[#ff4744] text-white"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 2.011 1.832 2.011.12.68-.219 1.598-.109 2.29zm9.262.046c-.189 1.17-1.245 2.042-2.554 2.042h-.217l.075-.138c.07-.127.135-.263.194-.405.059-.142.111-.292.155-.449.044-.157.08-.32.107-.489.027-.169.044-.343.05-.52.006-.177.002-.357-.012-.538-.014-.181-.038-.362-.072-.541-.034-.179-.078-.356-.131-.529-.053-.173-.115-.342-.185-.505-.07-.163-.148-.32-.233-.469-.085-.149-.177-.291-.275-.424-.098-.133-.202-.258-.311-.374-.109-.116-.223-.223-.341-.32-.118-.097-.24-.184-.366-.261-.126-.077-.255-.143-.387-.198-.132-.055-.267-.099-.404-.131-.137-.032-.276-.052-.416-.059-.14-.007-.281-.002-.421.015-.14.017-.279.046-.415.087-.136.041-.269.093-.397.156-.128.063-.251.136-.368.219-.117.083-.228.175-.332.276-.104.101-.2.21-.288.326-.088.116-.168.238-.239.366-.071.128-.133.261-.185.399-.052.138-.094.28-.126.425-.032.145-.053.293-.063.443-.01.15-.009.301.003.452.012.151.035.301.069.449.034.148.079.294.134.436.055.142.12.28.194.412.074.132.157.258.248.377.091.119.19.231.296.335.106.104.219.2.338.287.119.087.244.165.374.233.13.068.265.126.403.173.138.047.279.083.422.107.143.024.288.036.433.036h.217c1.309 0 2.365-.872 2.554-2.042.189-1.17-.567-2.042-1.876-2.042h-.217c-.145 0-.29.012-.433.036-.143.024-.284.06-.422.107-.138.047-.273.105-.403.173-.13.068-.255.146-.374.233-.119.087-.232.183-.338.287-.106.104-.205.216-.296.335-.091.119-.174.245-.248.377-.074.132-.139.27-.194.412-.055.142-.1.288-.134.436-.034.148-.057.298-.069.449-.012.151-.013.302-.003.452.01.15.031.298.063.443.032.145.074.287.126.425.052.138.114