      [0.15, 0.25, 0.25, 'T+10h'],
      [0.01, 0.05, 0.05, 'T+12h Nüchtern'],
    ];
    const el = document.getElementById('traj-container');
    const W = el ? el.offsetWidth - 48 : 600;
    make3DCanvas('traj-canvas', null, points, true, Math.max(W, 300), 380);
  }

  // ─── Init all ─────────────────────────────────────────────────────
  function init() {
    init2D();
    initEntropyAxis();
    initSubstanceCanvases();
    initTrajectory();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

