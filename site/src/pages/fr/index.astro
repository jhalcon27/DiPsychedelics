---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    slug: "how-does-it-feel-to-be-on-acid",
    title: "Qu’est-ce que ça fait d’être sous acide ?",
    subtitle: "Un modèle vectoriel des états de conscience",
    excerpt: "Un cadre pour cartographier les états modifiés de conscience à l’aide de trois axes : vigilance, engagement et entropie neuronale. Chaque substance est un vecteur.",
    image: "/images/what-is-it-like-to-be-on-acid.jpg",
    imagePosition: "center",
    date: "2026-04-16",
    readTime: "14 min de lecture",
    tags: ["Conscience", "Psychédéliques", "LSD", "Philosophie de l’esprit"],
  },
  {
    slug: 'how-do-you-learn-to-change-an-insight-from-sorrow',
    title: 'Comment apprend-on à changer ?',
    subtitle: 'Une leçon tirée du chagrin',
    excerpt: 'J\'ai remarqué ce schéma en moi relativement tard. Assez tard pour qu\'il ait déjà causé des dommages. Comment le deuil, l\'identité et la psychologie du développement se croisent dans le lent travail de devenir quelqu\'un d\'autre.',
    image: '/images/how-you-learn-to-change-from-sorrow.jpg',
    imagePosition: 'center',
    date: '2024-05-15',
    readTime: '4 min de lecture',
    tags: ['Réflexion personnelle', 'Chagrin', 'Changement'],
  },
  {
    slug: 'neural-networks-physics-modifying-reality',
    title: 'La voie vers la modification de la réalité',
    subtitle: 'Réseaux de neurones, physique et chronologie théorique',
    excerpt: 'La convergence des réseaux de neurones et de la physique ouvre une nouvelle voie fascinante : la possibilité de faire progresser l\'IA jusqu\'au point où elle pourrait modifier la réalité elle-même.',
    image: '/images/neural-networks.webp',
    imagePosition: 'center',
    date: '2025-06-15',
    readTime: '12 min de lecture',
    tags: ['Réseaux de neurones', 'Physique', 'Conscience'],
  },
  {
    slug: 'digital-fabric-of-reality',
    title: 'Le tissu numérique de la réalité',
    subtitle: 'Notre conscience est-elle intrinsèquement numérique ?',
    excerpt: 'De la théorie de la simulation à la physique quantique et à la théorie de l\'information intégrée : que signifie-t-il si la réalité et la conscience sont fondamentalement computationnelles ?',
    image: '/images/fabric-of-reality.jpeg',
    imagePosition: 'center',
    date: '2023-05-20',
    readTime: '7 min de lecture',
    tags: ['Conscience', 'Réalité numérique', 'Futurisme'],
  },
  {
    slug: 'mind-life-cosmos',
    title: 'L\'esprit, la vie et le cosmos',
    subtitle: 'L\'univers interconnecté',
    excerpt: 'Sur la relation entre l\'univers, l\'esprit et l\'évolution de la vie, et pourquoi comprendre cette interconnexion compte pour ce qui vient ensuite.',
    image: '/images/mind-life-cosmos.webp',
    imagePosition: 'top',
    date: '2023-06-10',
    readTime: '6 min de lecture',
    tags: ['Cosmos', 'Esprit', 'Interconnexion'],
  },
  {
    slug: 'fractality-of-organisation-and-emergence',
    title: 'La fractalité de l\'organisation et de l\'émergence',
    subtitle: 'Le panpsychisme s\'applique-t-il dans les deux directions ?',
    excerpt: 'Si la conscience est une propriété de la matière organisée, descend-elle jusqu\'aux électrons et monte-t-elle jusqu\'aux nations ? Ce que le couplage d\'états révèle sur l\'intérieur des échelles.',
    image: '/images/fractality-of-organisation-and-emergence.jpg',
    imagePosition: 'center',
    date: '2026-04-13',
    readTime: '8 min de lecture',
    tags: ['Panpsychisme', 'Émergence', 'Conscience', 'Complexité'],
  },
];
---

<Layout
  title="Digital Psychedelics | Explorer le futurisme et les réalités virtuelles"
  description="Digital Psychedelics, un blog personnel de Jhonatan Serna, ingénieur devenu banquier, explorant la physique, la conscience et la nature de l'existence."
  lang="fr"
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-cyber-cyan opacity-3 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6 fade-in">
          <span class="cyber-tag">Pensée d'avant-garde</span>
          <span class="text-cyber-muted text-xs font-mono">// explorer la conscience numérique</span>
        </div>

        <h1 class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6 fade-in" style="transition-delay: 0.1s">
          <span class="gradient-text">Digital</span><br/>
          <span class="text-cyber-text">Psychedelics</span>
        </h1>

        <p class="text-cyber-muted text-xl sm:text-2xl leading-relaxed mb-8 max-w-2xl fade-in" style="transition-delay: 0.2s">
          Explorer la convergence de la <span class="text-cyber-cyan">technologie</span>,
          de la <span class="text-cyber-purple">conscience</span> et du futur de l'expérience humaine.
        </p>

        <p class="text-cyber-muted text-base leading-relaxed mb-10 max-w-xl fade-in" style="transition-delay: 0.3s">
          Un blog personnel de Jhonatan Serna, ingénieur devenu banquier, obsédé par le concept de l'existence elle-même. Explorer la physique, la conscience et ce que signifie exister.
        </p>

        <div class="flex flex-wrap gap-4 fade-in" style="transition-delay: 0.4s">
          <a href="#featured" class="btn-cyber btn-cyber-filled">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Lire les articles
          </a>
          <a href="/fr/how-the-world-is-made" class="btn-cyber">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Géométrie sacrée
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-2 text-cyber-muted text-xs fade-in" style="transition-delay: 0.6s">
      <span class="font-mono tracking-widest">DÉFILER</span>
      <div class="w-px h-12 bg-gradient-to-b from-cyber-cyan to-transparent"></div>
    </div>
  </section>

  <div class="section-divider mx-8"></div>

  <!-- Featured Articles -->
  <section id="featured" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="cyber-tag">À la une</span>
          <div class="h-px flex-1 bg-gradient-to-r from-cyber-cyan/30 to-transparent max-w-xs"></div>
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-cyber-text">
          Dernières <span class="gradient-text">transmissions</span>
        </h2>
        <p class="text-cyber-muted mt-2 max-w-lg">
          Analyses approfondies à l'intersection de la technologie, de la conscience et de la nature de la réalité.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articles.map((article, i) => (
          <article class="glass-card rounded-lg overflow-hidden fade-in" style={`transition-delay: ${i * 0.1}s`}>
            <div class="relative overflow-hidden h-48">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                style={`object-position: ${article.imagePosition}`}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-cyber-dark/80 to-transparent"></div>
              <div class="absolute bottom-3 left-3 flex flex-wrap gap-1">
                {article.tags.slice(0, 2).map(tag => (
                  <span class="cyber-tag text-xs py-0.5">{tag}</span>
                ))}
              </div>
            </div>

            <div class="p-5">
              <div class="flex items-center gap-3 text-cyber-muted text-xs font-mono mb-3">
                <span>{article.readTime}</span>
              </div>
              <h3 class="font-display font-bold text-lg text-cyber-text mb-1 leading-tight">
                {article.title}
              </h3>
              <p class="text-cyber-cyan text-sm mb-3 font-medium">{article.subtitle}</p>
              <p class="text-cyber-muted text-sm leading-relaxed mb-4 line-clamp-3">
                {article.excerpt}
              </p>
              <a
                href={`/fr/blog/${article.slug}`}
                class="inline-flex items-center gap-2 text-cyber-cyan text-sm font-medium hover:gap-3 transition-all group"
              >
                Lire l'article
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider mx-8"></div>

  <!-- About Section -->
  <section id="about" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="relative fade-in order-2 lg:order-1">
          <div class="relative rounded-xl overflow-hidden">
            <img src="/images/about.jpeg" alt="À propos de Digital Psychedelics" class="w-full h-80 lg:h-96 object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tr from-cyber-dark/60 via-transparent to-cyber-purple/10"></div>
          </div>
        </div>
        <div class="fade-in order-1 lg:order-2" style="transition-delay: 0.2s">
          <div class="flex items-center gap-3 mb-4">
            <span class="cyber-tag">À propos</span>
          </div>
          <h2 class="font-display font-bold text-3xl sm:text-4xl text-cyber-text mb-6">
            À propos de <span class="gradient-text">Digital Psychedelics</span>
          </h2>
          <div class="space-y-4 text-cyber-muted leading-relaxed">
            <p>Digital Psychedelics est un blog personnel de Jhonatan Serna, un ingénieur devenu banquier obsédé par le concept de l'existence elle-même. Le site explore l'intersection de la physique, de la conscience et de la technologie à travers des articles et du contenu interactif.</p>
            <p>Les questions ici sont anciennes : qu'est-ce que la conscience ? Quelle est la relation entre l'esprit et la matière ? Que signifie exister ? Les outils pour les aborder sont nouveaux : neurosciences, théorie de l'information, IA et sciences de la complexité.</p>
            <p>Pas de réponses définitives, seulement une exploration honnête. Si ces questions vous tiennent aussi éveillé la nuit, vous êtes au bon endroit.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/fr/contact" class="btn-cyber btn-cyber-filled">Nous contacter</a>
            <a href="#featured" class="btn-cyber">Lire les articles</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
