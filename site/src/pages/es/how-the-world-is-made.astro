---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Cómo está hecho el mundo | Geometría Sagrada — Flor de la Vida & Sri Yantra"
  description="Explora dos de los símbolos de geometría sagrada más profundos de la humanidad a través de visualizaciones interactivas: el Sri Yantra y la Flor de la Vida."
  lang="es"
>
  <!-- Hero -->
  <section class="relative pt-12 pb-8 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav class="flex items-center gap-2 text-cyber-muted text-sm mb-8 font-mono">
        <a href="/es" class="hover:text-cyber-cyan transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-cyber-text">Cómo está hecho el mundo</span>
      </nav>

      <div class="max-w-3xl">
        <span class="cyber-tag mb-4 inline-block">Geometría Sagrada</span>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-cyber-text leading-tight mb-6">
          Cómo está hecho<br/>
          <span class="gradient-text">el mundo</span>
        </h1>
        <p class="text-cyber-muted text-xl leading-relaxed">
          Dos de los símbolos geométricos más profundos de la humanidad, la Flor de la Vida y el Sri Yantra,
          codifican verdades matemáticas profundas sobre la estructura de la realidad. Explóralos de forma interactiva.
        </p>
      </div>
    </div>
  </section>

  <!-- Navegación por pestañas -->
  <div class="sticky top-0 z-30 bg-cyber-dark/90 backdrop-blur border-b border-cyber-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-0">
        <a
          href="#sri-yantra"
          id="tab-yantra"
          class="sacred-tab active-tab px-5 py-3 text-sm font-mono border-b-2 transition-all duration-200"
        >
          ◈ Sri Yantra
        </a>
        <a
          href="#flower-of-life"
          id="tab-flower"
          class="sacred-tab px-5 py-3 text-sm font-mono border-b-2 transition-all duration-200"
        >
          ✦ Flor de la Vida
        </a>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 1 — SRI YANTRA -->
  <section id="sri-yantra" class="py-8 scroll-mt-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-6">
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-cyber-text">
          El Sri Yantra
        </h2>
        <p class="text-cyber-muted mt-2 max-w-2xl">
          Nueve triángulos entrelazados que crean 43 triángulos más pequeños a través de pura intersección
          geométrica, todos emergiendo de un único punto. Obsérvalo construirse paso a paso.
        </p>
      </div>

      <!-- Canvas -->
      <div class="glass-card rounded-xl overflow-hidden fade-in">
        <div class="flex items-center justify-between px-6 py-3 border-b border-cyber-border">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-cyber-muted text-xs font-mono">sri-yantra.js — construcción interactiva</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyber-cyan pulse-glow"></span>
            <span class="text-cyber-muted text-xs font-mono">live</span>
            <span id="qa-status" class="text-xs font-mono opacity-60 ml-2"></span>
          </div>
        </div>

        <div id="yantra-container" class="w-full bg-cyber-dark flex items-center justify-center" style="min-height: 420px;"></div>

        <div class="yantra-step-info px-6 py-4 border-t border-cyber-border" style="min-height:5rem;">
          <div class="flex items-center justify-between mb-1">
            <span id="step-title" class="text-cyber-cyan text-sm font-mono font-semibold tracking-wide">Inicializando…</span>
            <span id="step-progress" class="text-cyber-muted text-xs font-mono">— / 12</span>
          </div>
          <p id="step-desc" class="text-cyber-muted text-sm leading-relaxed">El Sri Yantra emerge de un único punto, el bindu.</p>
          <div class="mt-3 h-0.5 bg-cyber-border rounded overflow-hidden">
            <div id="progress-bar" class="h-full rounded transition-all duration-400" style="width:0%;background:linear-gradient(90deg,#00f0ff,#b44aff);"></div>
          </div>
        </div>
      </div>

      <!-- Controles -->
      <div class="mt-4 glass-card rounded-xl p-4 fade-in">
        <div class="flex flex-wrap items-center gap-4 justify-center">
          <div class="flex items-center gap-2">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Construir</label>
            <button id="play-btn"   class="btn-cyber text-xs py-1.5 px-3">Auto-Construcción</button>
            <button id="step-btn"   class="btn-cyber text-xs py-1.5 px-3">Paso →</button>
            <button id="reset-btn"  class="btn-cyber text-xs py-1.5 px-3">Reiniciar</button>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Velocidad</label>
            <input type="range" id="speed-slider" min="1" max="100" value="50" class="w-24 accent-cyber-cyan" />
            <span id="speed-value" class="text-cyber-cyan text-xs font-mono w-4">50</span>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Respirar</label>
            <button id="breathe-btn" class="btn-cyber text-xs py-1.5 px-3">Respirar</button>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Tema</label>
            <button id="yantra-theme-btn" class="btn-cyber text-xs py-1.5 px-3">Cambiar</button>
            <span id="theme-label" class="text-cyber-cyan text-xs font-mono" style="min-width:3.5rem;">Gold</span>
          </div>
        </div>
      </div>

      <!-- Explicación -->
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div class="fade-in">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">01</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">Los nueve triángulos</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              El Sri Yantra está construido a partir de exactamente 9 triángulos entrelazados: 4 apuntan hacia
              arriba (representando a Shiva, el principio masculino) y 5 hacia abajo (Shakti, el principio femenino).
              Sus intersecciones crean 43 triángulos más pequeños, cada uno con significado simbólico específico.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              La construcción es matemáticamente precisa: los vértices de cada triángulo deben yacer exactamente
              sobre los círculos circunscritos, y las intersecciones deben alinearse perfectamente. Por eso el
              Sri Yantra se considera uno de los símbolos sagrados geométricamente más complejos jamás concebidos.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.1s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">02</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">El Bindu, punto de origen</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              En el centro del Sri Yantra está el <em>bindu</em>, un punto único que representa la fuente
              indiferenciada de toda la creación. En la cosmología tántrica, el universo entero se despliega
              desde este punto, así como todo el yantra se despliega geométricamente desde él.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Esto refleja un principio fundamental de la física: el Big Bang como singularidad desde la que
              emergió toda estructura. El Sri Yantra codifica esta intuición cosmológica en geometría pura,
              milenios antes de la cosmología moderna.
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <div class="fade-in" style="transition-delay: 0.2s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">03</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">Complejidad desde la simplicidad</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              El Sri Yantra demuestra el mismo principio que la Flor de la Vida y los autómatas celulares:
              complejidad extraordinaria emergiendo de reglas simples e iteradas. Nueve triángulos, trazados
              en secuencia, crean una estructura de 43 subtriángulos a través de pura intersección geométrica.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Desde la perspectiva de la conciencia digital, esto es una prueba visual de que la densidad
              de información puede comprimirse en reglas mínimas — el mismo principio que subyace a las
              redes neuronales, la geometría fractal y la estructura del espacio-tiempo.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.3s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">04</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">El Loto y la Bhupura</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Rodeando los triángulos hay dos anillos de pétalos de loto (8 internos, 16 externos), que
              representan el despliegue de la creación en el mundo manifiesto. El elemento más externo, la
              <em>bhupura</em> (cuadrado de tierra), marca el límite entre la geometría sagrada y el espacio
              ordinario, con cuatro puertas en las direcciones cardinales.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              La estructura completa codifica un mapa cosmológico: desde el bindu indiferenciado, pasando por
              la interacción dinámica de los principios masculino y femenino, hasta el loto de la manifestación
              y el plano terrenal — un modelo completo de la realidad en forma geométrica.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 my-8"></div>

  <!-- SECCIÓN 2 — FLOR DE LA VIDA -->
  <section id="flower-of-life" class="py-8 scroll-mt-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-6">
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-cyber-text">
          La Flor de la Vida
        </h2>
        <p class="text-cyber-muted mt-2 max-w-2xl">
          Uno de los patrones geométricos más antiguos de la historia humana, encontrado en culturas antiguas
          de múltiples continentes. Una exploración interactiva de su estructura.
        </p>
      </div>

      <div class="glass-card rounded-xl overflow-hidden fade-in">
        <div class="flex items-center justify-between px-6 py-3 border-b border-cyber-border">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-cyber-muted text-xs font-mono">flower-of-life.js — interactivo</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyber-cyan pulse-glow"></span>
            <span class="text-cyber-muted text-xs font-mono">live</span>
          </div>
        </div>
        <div id="flower-canvas-container" class="w-full bg-cyber-dark flex items-center justify-center" style="min-height: 500px;">
          <div id="loading-indicator" class="flex flex-col items-center gap-3 text-cyber-muted">
            <div class="cyber-spinner"></div>
            <span class="text-sm font-mono">Inicializando geometría sagrada...</span>
          </div>
        </div>
      </div>

      <div class="mt-4 glass-card rounded-xl p-4 fade-in">
        <div class="flex flex-wrap items-center gap-4 justify-center">
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Anillos</label>
            <input type="range" id="rings-slider" min="1" max="7" value="4" class="w-24 accent-cyber-cyan" />
            <span id="rings-value" class="text-cyber-cyan text-xs font-mono w-4">4</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Tamaño</label>
            <input type="range" id="size-slider" min="20" max="80" value="45" class="w-24 accent-cyber-cyan" />
            <span id="size-value" class="text-cyber-cyan text-xs font-mono w-8">45</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Animar</label>
            <button id="animate-btn" class="btn-cyber text-xs py-1.5 px-3">Iniciar</button>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Tema</label>
            <button id="fol-theme-btn" class="btn-cyber text-xs py-1.5 px-3">Cambiar</button>
          </div>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div class="fade-in">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">01</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">El símbolo antiguo</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              La Flor de la Vida es una figura geométrica compuesta de múltiples círculos superpuestos,
              uniformemente espaciados, dispuestos en un patrón similar a una flor con simetría séxtuple.
              Ha sido encontrada en el antiguo Egipto, China, India, Israel y en todo el Mediterráneo,
              apareciendo de forma independiente en culturas sin contacto conocido entre sí.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Las representaciones más antiguas conocidas se encuentran en el Templo de Osiris en Abydos,
              Egipto, con al menos 6.000 años de antigüedad. No fueron pintadas, sino quemadas o grabadas
              en el granito, lo que indica que se trataron con especial cuidado.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.1s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">02</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">Matemáticas sagradas</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Dentro de la Flor de la Vida se encuentra el Fruto de la Vida: 13 círculos que forman la base
              del Cubo de Metatrón, el cual contiene los cinco sólidos platónicos (tetraedro, cubo, octaedro,
              dodecaedro e icosaedro). Los filósofos griegos antiguos propusieron estos sólidos como modelos
              de los elementos fundamentales de la materia.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              El patrón también codifica la proporción áurea (φ ≈ 1,618), la sucesión de Fibonacci y
              relaciones matemáticas que recurren en toda la naturaleza, desde la espiral de un nautilo
              hasta la disposición de las semillas en un girasol.
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <div class="fade-in" style="transition-delay: 0.2s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">03</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">La conexión digital</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Desde la perspectiva de la conciencia digital, la Flor de la Vida es fascinante porque demuestra
              cómo puede emerger complejidad infinita a partir de una sola regla simple: dibuja un círculo,
              luego dibuja otro del mismo tamaño centrado en el borde del primero.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Así es exactamente como funcionan los autómatas celulares y los algoritmos fractales: reglas
              simples iteradas repetidamente para producir complejidad extraordinaria. Si el universo opera
              según principios similares es una pregunta abierta en física, pero el paralelismo estructural
              merece examinarse.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.3s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">04</span>
              </div>
              <h3 class="font-display font-bold text-xl text-cyber-text">Conciencia y patrón</h3>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Las personas que han experimentado estados alterados de conciencia, a través de meditación,
              respiración u psicodélicos, frecuentemente reportan ver patrones geométricos similares a la
              Flor de la Vida. Esta es una observación fenomenológica documentada, aunque su interpretación
              sigue siendo una pregunta abierta.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Una hipótesis es que estos patrones reflejan la propia arquitectura de procesamiento visual
              del cerebro hecha visible. Otra es que apuntan a algo más fundamental sobre cómo el sistema
              nervioso modela la estructura. De cualquier manera, la recurrencia de esta geometría específica
              en el arte antiguo y los estados alterados merece tomarse en serio.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card rounded-xl p-8 text-center fade-in animated-border">
        <h2 class="font-display font-bold text-2xl text-cyber-text mb-4">
          Explorar más <span class="gradient-text">Transmisiones</span>
        </h2>
        <p class="text-cyber-muted mb-6 max-w-lg mx-auto">
          Sumérgete en la intersección de tecnología, conciencia y la naturaleza de la realidad.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/es/#featured" class="btn-cyber btn-cyber-filled">Leer artículos</a>
          <a href="/es/contact" class="btn-cyber">Contacto</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sacred-tab {
    color: theme('colors.cyber-muted', #8888aa);
    border-color: transparent;
    text-decoration: none;
  }
  .sacred-tab:hover {
    color: theme('colors.cyber-cyan', #00f0ff);
    border-color: rgba(0, 240, 255, 0.3);
  }
  .sacred-tab.active-tab {
    color: #00f0ff;
    border-color: #00f0ff;
  }
  :global(svg .triangle),
  :global(svg .circle),
  :global(svg .petal),
  :global(svg .bhupura),
  :global(svg #bindu-group) {
    transition: opacity 0.6s ease;
  }
  #yantra-container { padding: 0.5rem 0; }
  #progress-bar { transition: width 0.4s ease; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
<script src="/sri-yantra.js" is:inline></script>

<script>
  (function () {
    const tabFlower = document.getElementById('tab-flower');
    const tabYantra = document.getElementById('tab-yantra');
    const secFlower = document.getElementById('flower-of-life');
    const secYantra = document.getElementById('sri-yantra');
    function setActive(tab: HTMLElement) {
      [tabFlower, tabYantra].forEach(t => t?.classList.remove('active-tab'));
      tab.classList.add('active-tab');
    }
    tabFlower?.addEventListener('click', (e) => { e.preventDefault(); secFlower?.scrollIntoView({ behavior: 'smooth', block: 'start' }); setActive(tabFlower); });
    tabYantra?.addEventListener('click', (e) => { e.preventDefault(); secYantra?.scrollIntoView({ behavior: 'smooth', block: 'start' }); setActive(tabYantra); });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (entry.target.id === 'flower-of-life' && tabFlower) setActive(tabFlower);
          if (entry.target.id === 'sri-yantra'    && tabYantra) setActive(tabYantra);
        }
      });
    }, { threshold: 0.3 });
    if (secFlower) observer.observe(secFlower);
    if (secYantra) observer.observe(secYantra);
  })();
</script>

<script>
  window.addEventListener('load', () => {
    const container = document.getElementById('flower-canvas-container');
    const loadingIndicator = document.getElementById('loading-indicator');
    const ringsSlider = document.getElementById('rings-slider') as HTMLInputElement;
    const ringsValue = document.getElementById('rings-value');
    const sizeSlider = document.getElementById('size-slider') as HTMLInputElement;
    const sizeValue = document.getElementById('size-value');
    const animateBtn = document.getElementById('animate-btn');
    const themeBtn = document.getElementById('fol-theme-btn');
    if (!container || typeof (window as any).p5 === 'undefined') return;
    loadingIndicator?.remove();
    let isAnimating = false;
    let animationAngle = 0;
    let currentTheme = 0;
    const themes = [
      { primary: '#00f0ff', secondary: '#b44aff', bg: '#0a0a0f' },
      { primary: '#ff6b35', secondary: '#f7c59f', bg: '#0f0a05' },
      { primary: '#39ff14', secondary: '#00ff88', bg: '#050f05' },
      { primary: '#ff0080', secondary: '#ff6ec7', bg: '#0f0005' },
    ];
    const sketch = (p: any) => {
      let ellipseRadius = 45;
      let maxRings = 4;
      let allPetals: any[] = [];
      let ellipseOrigin: { x: number; y: number };
      let canvasWidth: number;
      let canvasHeight: number;
      p.setup = () => {
        canvasWidth = container!.offsetWidth;
        canvasHeight = Math.min(canvasWidth * 0.7, 550);
        const canvas = p.createCanvas(canvasWidth, canvasHeight);
        canvas.parent('flower-canvas-container');
        p.colorMode(p.HSB, 360, 100, 100, 1);
        p.angleMode(p.DEGREES);
        ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 };
        ellipseRadius = parseInt(sizeSlider?.value || '45');
        maxRings = parseInt(ringsSlider?.value || '4');
        buildPetals();
        p.noLoop();
      };
      p.draw = () => {
        const theme = themes[currentTheme];
        p.background(p.color(theme.bg));
        p.stroke(0, 0, 100, 0.03); p.strokeWeight(0.5);
        for (let x = 0; x < canvasWidth; x += 30) p.line(x, 0, x, canvasHeight);
        for (let y = 0; y < canvasHeight; y += 30) p.line(0, y, canvasWidth, y);
        if (isAnimating) { animationAngle += 0.3; p.translate(ellipseOrigin.x, ellipseOrigin.y); p.rotate(animationAngle); p.translate(-ellipseOrigin.x, -ellipseOrigin.y); }
        allPetals.forEach((petal) => {
          const t = themes[currentTheme];
          if (petal.round % 2 === 0) { p.stroke(p.color(t.primary + '66')); p.fill(p.color(t.primary + '08')); }
          else { p.stroke(p.color(t.secondary + '66')); p.fill(p.color(t.secondary + '08')); }
          p.strokeWeight(0.8); p.ellipse(petal.x, petal.y, petal.diameter);
        });
        p.noStroke();
        const t2 = themes[currentTheme];
        p.fill(p.color(t2.primary + '15')); p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 2.5);
        p.fill(p.color(t2.primary + '08')); p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 4);
      };
      function buildPetals() {
        allPetals = [];
        let firstIntersection = 0;
        let petalCount = 0;
        for (let roundCount = 0; roundCount <= maxRings; roundCount++) {
          const offset = roundCount > 0 ? 360 / (roundCount * 6) : 0;
          if (roundCount === 0) { allPetals.push({ index: petalCount, x: ellipseOrigin.x, y: ellipseOrigin.y, diameter: ellipseRadius * 2, round: roundCount, angle: 0 }); petalCount++; continue; }
          for (let i = 0; i < roundCount * 6; i++) {
            let x, y;
            if (roundCount === 1 && i === 0) { x = ellipseOrigin.x + ellipseRadius * p.cos(0); y = ellipseOrigin.y + ellipseRadius * p.sin(0); }
            else { const prev = allPetals[petalCount - 1]; const inter = allPetals[firstIntersection]; const intersection = getIntersection(prev, inter, ellipseRadius); if (!intersection) continue; x = intersection.x; y = intersection.y; }
            const angle = getPetalAngle(x, y);
            allPetals.push({ index: petalCount, x, y, diameter: ellipseRadius * 2, round: roundCount, angle });
            petalCount++;
            const vertexCalc = (angle + offset) % 60 > 1;
            if (i === roundCount * 6 - 1) firstIntersection++;
            else if (vertexCalc) firstIntersection++;
          }
        }
      }
      function getIntersection(a: any, b: any, r: number) {
        const dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.hypot(dx, dy);
        if (d > r * 2 || d < Math.abs(0)) return null;
        const aa = (r * r - r * r + d * d) / (2 * d);
        const x2 = a.x + (dx * aa) / d, y2 = a.y + (dy * aa) / d;
        const h = Math.sqrt(Math.max(0, r * r - aa * aa));
        const rx = -dy * (h / d), ry = dx * (h / d);
        return { x: x2 - rx, y: y2 - ry };
      }
      function getPetalAngle(px: number, py: number) {
        let theta = Math.atan2(py - ellipseOrigin.y, px - ellipseOrigin.x) * 180 / Math.PI;
        if (theta < 0) theta = 360 + theta;
        return Math.round(theta);
      }
      (window as any).rebuildFlower = (rings: number, size: number) => { maxRings = rings; ellipseRadius = size; buildPetals(); if (!isAnimating) p.redraw(); };
      (window as any).toggleAnimation = () => { isAnimating = !isAnimating; if (isAnimating) { p.loop(); } else { animationAngle = 0; p.noLoop(); p.redraw(); } return isAnimating; };
      (window as any).cycleFolTheme = () => { currentTheme = (currentTheme + 1) % themes.length; if (!isAnimating) p.redraw(); };
      window.addEventListener('resize', () => { canvasWidth = container!.offsetWidth; canvasHeight = Math.min(canvasWidth * 0.7, 550); p.resizeCanvas(canvasWidth, canvasHeight); ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 }; buildPetals(); if (!isAnimating) p.redraw(); });
    };
    new (window as any).p5(sketch);
    ringsSlider?.addEventListener('input', () => { const val = parseInt(ringsSlider.value); if (ringsValue) ringsValue.textContent = String(val); (window as any).rebuildFlower?.(val, parseInt(sizeSlider?.value || '45')); });
    sizeSlider?.addEventListener('input', () => { const val = parseInt(sizeSlider.value); if (sizeValue) sizeValue.textContent = String(val); (window as any).rebuildFlower?.(parseInt(ringsSlider?.value || '4'), val); });
    animateBtn?.addEventListener('click', () => { const on = (window as any).toggleAnimation?.(); if (animateBtn) animateBtn.textContent = on ? 'Detener' : 'Iniciar'; });
    themeBtn?.addEventListener('click', () => { (window as any).cycleFolTheme?.(); });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const yantraThemeBtn = document.getElementById('yantra-theme-btn');
    const themeLabel     = document.getElementById('theme-label');
    yantraThemeBtn?.addEventListener('click', () => {
      const name = (window as any)._yantra?.cycleTheme?.();
      if (themeLabel && name) themeLabel.textContent = name;
    });
  });
</script>
