---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Cómo está hecho el mundo | Geometría Sagrada y la Flor de la Vida"
  description="Explora la Flor de la Vida, uno de los patrones geométricos más antiguos conocidos, a través de una visualización generativa interactiva. Descubre las relaciones matemáticas que codifica."
  lang="es"
>
  <!-- Hero -->
  <section class="relative pt-12 pb-8 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <nav class="flex items-center gap-2 text-cyber-muted text-sm mb-8 font-mono">
        <a href="/es" class="hover:text-cyber-cyan transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-cyber-text">Cómo está hecho el mundo</span>
      </nav>

      <div class="max-w-3xl">
        <span class="cyber-tag mb-4 inline-block">Geometría Sagrada</span>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-cyber-text leading-tight mb-6">
          Cómo está hecho<br/>
          <span class="gradient-text">el mundo</span>
        </h1>
        <p class="text-cyber-muted text-xl leading-relaxed">
          La Flor de la Vida es uno de los patrones geométricos más antiguos conocidos en la historia humana, encontrado en culturas antiguas en múltiples continentes. Esta es una exploración interactiva de su estructura.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Canvas -->
  <section class="py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card rounded-xl overflow-hidden fade-in">
        <div class="flex items-center justify-between px-6 py-3 border-b border-cyber-border">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-cyber-muted text-xs font-mono">flower-of-life.js — interactivo</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyber-cyan pulse-glow"></span>
            <span class="text-cyber-muted text-xs font-mono">live</span>
          </div>
        </div>
        <div id="flower-canvas-container" class="w-full bg-cyber-dark flex items-center justify-center" style="min-height: 500px;">
          <div id="loading-indicator" class="flex flex-col items-center gap-3 text-cyber-muted">
            <div class="cyber-spinner"></div>
            <span class="text-sm font-mono">Iniciando geometría sagrada...</span>
          </div>
        </div>
      </div>

      <div class="mt-4 glass-card rounded-xl p-4 fade-in">
        <div class="flex flex-wrap items-center gap-4 justify-center">
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Anillos</label>
            <input type="range" id="rings-slider" min="1" max="7" value="4" class="w-24 accent-cyber-cyan" />
            <span id="rings-value" class="text-cyber-cyan text-xs font-mono w-4">4</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Tamaño</label>
            <input type="range" id="size-slider" min="20" max="80" value="45" class="w-24 accent-cyber-cyan" />
            <span id="size-value" class="text-cyber-cyan text-xs font-mono w-8">45</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Animar</label>
            <button id="animate-btn" class="btn-cyber text-xs py-1.5 px-3">Iniciar</button>
          </div>
          <div class="flex items-center gap-3">
            <label class="text-cyber-muted text-xs font-mono uppercase tracking-wider">Tema</label>
            <button id="theme-btn" class="btn-cyber text-xs py-1.5 px-3">Ciclar</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 my-8"></div>

  <!-- Explanation -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="space-y-8">
          <div class="fade-in">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">01</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">El símbolo ancestral</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              La Flor de la Vida es una figura geométrica compuesta de múltiples círculos igualmente espaciados y superpuestos, dispuestos en un patrón floral con simetría de seis puntas. Se ha encontrado en el antiguo Egipto, China, India, Israel y a lo largo del Mediterráneo, apareciendo de forma independiente en culturas sin contacto conocido entre sí.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Las representaciones más antiguas conocidas se encuentran en el Templo de Osiris en Abidos, Egipto, con una antigüedad de al menos 6.000 años. Estas no fueron pintadas, sino que parecen haber sido grabadas o quemadas en el granito, lo que indica que se trataron con especial cuidado.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.1s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">02</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Matemáticas sagradas</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Dentro de la Flor de la Vida se puede encontrar el Fruto de la Vida: 13 círculos que forman la base del Cubo de Metatrón, que contiene los cinco sólidos platónicos (tetraedro, cubo, octaedro, dodecaedro e icosaedro). Los filósofos griegos los propusieron como modelos de los elementos fundamentales de la materia.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              El patrón también codifica la proporción áurea (φ ≈ 1,618), la secuencia de Fibonacci y relaciones matemáticas que se repiten en la naturaleza, desde la espiral de un nautilo hasta la disposición de las semillas en un girasol.
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <div class="fade-in" style="transition-delay: 0.2s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center">
                <span class="text-cyber-cyan text-sm font-mono font-bold">03</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">La conexión digital</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Desde una perspectiva de conciencia digital, la Flor de la Vida es fascinante porque demuestra cómo puede emerger una complejidad infinita de una sola regla simple: dibuja un círculo, luego dibuja otro del mismo tamaño centrado en el borde del primero.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Así es exactamente como funcionan los autómatas celulares y los algoritmos fractales: reglas simples iteradas repetidamente para producir una complejidad extraordinaria. Si el universo opera según principios similares es una pregunta abierta en física, pero el paralelo estructural merece ser examinado.
            </p>
          </div>

          <div class="fade-in" style="transition-delay: 0.3s">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center">
                <span class="text-cyber-purple text-sm font-mono font-bold">04</span>
              </div>
              <h2 class="font-display font-bold text-xl text-cyber-text">Conciencia y patrón</h2>
            </div>
            <p class="text-cyber-muted leading-relaxed">
              Personas que han experimentado estados alterados de conciencia, a través de meditación, respiración consciente o psicodélicos, informan frecuentemente de ver patrones geométricos similares a la Flor de la Vida. Esta es una observación fenomenológica documentada, aunque su interpretación sigue siendo una pregunta abierta.
            </p>
            <p class="text-cyber-muted leading-relaxed mt-3">
              Una hipótesis es que estos patrones reflejan la propia arquitectura de procesamiento visual del cerebro hecha visible. Otra es que apuntan a algo más fundamental sobre cómo el sistema nervioso modela la estructura. En cualquier caso, la recurrencia de esta geometría específica tanto en el arte antiguo como en los estados alterados merece tomarse en serio.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card rounded-xl p-8 text-center fade-in animated-border">
        <h2 class="font-display font-bold text-2xl text-cyber-text mb-4">
          Explorar más <span class="gradient-text">transmisiones</span>
        </h2>
        <p class="text-cyber-muted mb-6 max-w-lg mx-auto">
          Sumérgete en la intersección de tecnología, conciencia y la naturaleza de la realidad.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/es#featured" class="btn-cyber btn-cyber-filled">Leer artículos</a>
          <a href="/es/contact" class="btn-cyber">Ponerse en contacto</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>

<script>
  window.addEventListener('load', () => {
    const container = document.getElementById('flower-canvas-container');
    const loadingIndicator = document.getElementById('loading-indicator');
    const ringsSlider = document.getElementById('rings-slider') as HTMLInputElement;
    const ringsValue = document.getElementById('rings-value');
    const sizeSlider = document.getElementById('size-slider') as HTMLInputElement;
    const sizeValue = document.getElementById('size-value');
    const animateBtn = document.getElementById('animate-btn');
    const themeBtn = document.getElementById('theme-btn');

    if (!container || typeof (window as any).p5 === 'undefined') return;
    loadingIndicator?.remove();

    let isAnimating = false;
    let animationAngle = 0;
    let currentTheme = 0;

    const themes = [
      { primary: '#00f0ff', secondary: '#b44aff', bg: '#0a0a0f' },
      { primary: '#ff6b35', secondary: '#f7c59f', bg: '#0f0a05' },
      { primary: '#39ff14', secondary: '#00ff88', bg: '#050f05' },
      { primary: '#ff0080', secondary: '#ff6ec7', bg: '#0f0005' },
    ];

    const sketch = (p: any) => {
      let ellipseRadius = 45;
      let maxRings = 4;
      let allPetals: any[] = [];
      let ellipseOrigin: { x: number; y: number };
      let canvasWidth: number;
      let canvasHeight: number;

      p.setup = () => {
        canvasWidth = container!.offsetWidth;
        canvasHeight = Math.min(canvasWidth * 0.7, 550);
        const canvas = p.createCanvas(canvasWidth, canvasHeight);
        canvas.parent('flower-canvas-container');
        p.colorMode(p.HSB, 360, 100, 100, 1);
        p.angleMode(p.DEGREES);
        ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 };
        ellipseRadius = parseInt(sizeSlider?.value || '45');
        maxRings = parseInt(ringsSlider?.value || '4');
        buildPetals();
        p.noLoop();
      };

      p.draw = () => {
        const theme = themes[currentTheme];
        p.background(p.color(theme.bg));
        p.stroke(0, 0, 100, 0.03);
        p.strokeWeight(0.5);
        for (let x = 0; x < canvasWidth; x += 30) p.line(x, 0, x, canvasHeight);
        for (let y = 0; y < canvasHeight; y += 30) p.line(0, y, canvasWidth, y);

        if (isAnimating) {
          animationAngle += 0.3;
          p.translate(ellipseOrigin.x, ellipseOrigin.y);
          p.rotate(animationAngle);
          p.translate(-ellipseOrigin.x, -ellipseOrigin.y);
        }

        allPetals.forEach((petal) => {
          const theme = themes[currentTheme];
          if (petal.round % 2 === 0) {
            p.stroke(p.color(theme.primary + '66'));
            p.fill(p.color(theme.primary + '08'));
          } else {
            p.stroke(p.color(theme.secondary + '66'));
            p.fill(p.color(theme.secondary + '08'));
          }
          p.strokeWeight(0.8);
          p.ellipse(petal.x, petal.y, petal.diameter);
        });

        p.noStroke();
        const theme2 = themes[currentTheme];
        p.fill(p.color(theme2.primary + '15'));
        p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 2.5);
        p.fill(p.color(theme2.primary + '08'));
        p.ellipse(ellipseOrigin.x, ellipseOrigin.y, ellipseRadius * 4);
      };

      function buildPetals() {
        allPetals = [];
        let firstIntersection = 0;
        let petalCount = 0;
        for (let roundCount = 0; roundCount <= maxRings; roundCount++) {
          const offset = roundCount > 0 ? 360 / (roundCount * 6) : 0;
          if (roundCount === 0) {
            allPetals.push({ index: petalCount, x: ellipseOrigin.x, y: ellipseOrigin.y, diameter: ellipseRadius * 2, round: roundCount, angle: 0 });
            petalCount++;
            continue;
          }
          for (let i = 0; i < roundCount * 6; i++) {
            let x, y;
            if (roundCount === 1 && i === 0) {
              x = ellipseOrigin.x + ellipseRadius * p.cos(0);
              y = ellipseOrigin.y + ellipseRadius * p.sin(0);
            } else {
              const prev = allPetals[petalCount - 1];
              const inter = allPetals[firstIntersection];
              const intersection = getIntersection(prev, inter, ellipseRadius);
              if (!intersection) continue;
              x = intersection.x;
              y = intersection.y;
            }
            const angle = getPetalAngle(x, y);
            allPetals.push({ index: petalCount, x, y, diameter: ellipseRadius * 2, round: roundCount, angle });
            petalCount++;
            const vertexCalc = (angle + offset) % 60 > 1;
            if (i === roundCount * 6 - 1) firstIntersection++;
            else if (vertexCalc) firstIntersection++;
          }
        }
      }

      function getIntersection(a: any, b: any, r: number) {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy);
        if (d > r * 2 || d < Math.abs(0)) return null;
        const aa = (r * r - r * r + d * d) / (2 * d);
        const x2 = a.x + (dx * aa) / d;
        const y2 = a.y + (dy * aa) / d;
        const h = Math.sqrt(Math.max(0, r * r - aa * aa));
        const rx = -dy * (h / d);
        const ry = dx * (h / d);
        return { x: x2 - rx, y: y2 - ry };
      }

      function getPetalAngle(px: number, py: number) {
        let theta = Math.atan2(py - ellipseOrigin.y, px - ellipseOrigin.x);
        theta *= 180 / Math.PI;
        if (theta < 0) theta = 360 + theta;
        return Math.round(theta);
      }

      (window as any).rebuildFlower = (rings: number, size: number) => {
        maxRings = rings; ellipseRadius = size; buildPetals();
        if (!isAnimating) p.redraw();
      };
      (window as any).toggleAnimation = () => {
        isAnimating = !isAnimating;
        if (isAnimating) p.loop(); else { animationAngle = 0; p.noLoop(); p.redraw(); }
        return isAnimating;
      };
      (window as any).cycleTheme = () => {
        currentTheme = (currentTheme + 1) % themes.length;
        if (!isAnimating) p.redraw();
      };
      window.addEventListener('resize', () => {
        canvasWidth = container!.offsetWidth;
        canvasHeight = Math.min(canvasWidth * 0.7, 550);
        p.resizeCanvas(canvasWidth, canvasHeight);
        ellipseOrigin = { x: canvasWidth / 2, y: canvasHeight / 2 };
        buildPetals();
        if (!isAnimating) p.redraw();
      });
    };

    new (window as any).p5(sketch);

    ringsSlider?.addEventListener('input', () => {
      const val = parseInt(ringsSlider.value);
      if (ringsValue) ringsValue.textContent = String(val);
      (window as any).rebuildFlower?.(val, parseInt(sizeSlider?.value || '45'));
    });
    sizeSlider?.addEventListener('input', () => {
      const val = parseInt(sizeSlider.value);
      if (sizeValue) sizeValue.textContent = String(val);
      (window as any).rebuildFlower?.(parseInt(ringsSlider?.value || '4'), val);
    });
    animateBtn?.addEventListener('click', () => {
      const isNowAnimating = (window as any).toggleAnimation?.();
      if (animateBtn) animateBtn.textContent = isNowAnimating ? 'Parar' : 'Iniciar';
    });
    themeBtn?.addEventListener('click', () => { (window as any).cycleTheme?.(); });
  });
</script>
