      [0.85, 0.80, 0.95, 'T+3h Peak'],
      [0.75, 0.70, 0.80, 'T+5h Plateau'],
      [0.60, 0.55, 0.60, 'T+6h'],
      [0.40, 0.40, 0.35, 'T+8h Comedown'],
      [0.15, 0.20, 0.15, 'T+10h'],
      [0.05, 0.05, 0.05, 'T+12h Return'],
    ];
    const el = document.getElementById('traj-container');
    const W = el ? el.offsetWidth - 48 : 600;
    make3DCanvas('traj-canvas', null, points, true, Math.max(W, 300), 380);
  }

  // ─── Init all ─────────────────────────────────────────────────────
  function init() {
    init2D();

    const substances3D = [
      { label: 'Coffee',     alert:  0.80, engage:  0.40, entropy:  0.05, color: '#ffe066' },
      { label: 'Nicotine',   alert:  0.50, engage:  0.40, entropy:  0.00, color: '#c8f0c8' },
      { label: 'Alcohol',    alert: -0.60, engage: -0.50, entropy:  0.15, color: '#aaddff' },
      { label: 'Cannabis',   alert: -0.10, engage: -0.20, entropy:  0.60, color: '#88ff88' },
      { label: 'MDMA',       alert:  0.70, engage:  0.90, entropy:  0.30, color: '#ff88cc' },
      { label: 'Ketamine',   alert: -0.50, engage: -0.70, entropy:  0.50, color: '#cc88ff' },
      { label: 'Meditation', alert:  0.60, engage:  0.70, entropy: -0.80, color: '#ffffff' },
      { label: 'Depression', alert: -0.10, engage: -0.60, entropy: -0.90, color: '#666699' },
      { label: 'LSD',        alert:  0.85, engage:  0.80, entropy:  0.95, color: '#ff4444' },
    ];

    const el3d = document.getElementById('viz3d-container');
    const W3d = el3d ? el3d.offsetWidth - 48 : 600;
    make3DCanvas('viz3d', substances3D, null, false, Math.max(W3d, 300), 420);

    initSubstanceCanvases();
    initTrajectory();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

