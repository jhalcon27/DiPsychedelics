    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  .substance-card {
    padding: 1.25rem;
    border-radius: 10px;
  }
