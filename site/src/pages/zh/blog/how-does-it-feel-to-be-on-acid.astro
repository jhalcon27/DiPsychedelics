<script is:inline>
(function() {

  // ─── 共享辅助函数 ───────────────────────────────────────────────
  const C = { bg: '#0a0a0f', cyan: '#00f0ff', purple: '#b44aff', muted: '#8888aa', white: '#e0e0ff' };

  function project3D(x, y, z, cx, cy, scale, rx, ry) {
    // 简单的等距投影及旋转
    const cosRY = Math.cos(ry), sinRY = Math.sin(ry);
    const cosRX = Math.cos(rx), sinRX = Math.sin(rx);
    // 绕 Y 轴旋转
    const x1 = x * cosRY - z * sinRY;
    const z1 = x * sinRY + z * cosRY;
    // 绕 X 轴旋转
    const y2 = y * cosRX - z1 * sinRX;
    const z2 = y * sinRX + z1 * cosRX;
    return { sx: cx + x1 * scale, sy: cy - y2 * scale, depth: z2 };
  }

  function drawArrow(ctx, x1, y1, x2, y2, color, width, label) {
    const dx = x2 - x1, dy = y2 - y1;
    const len = Math.sqrt(dx * dx + dy * dy);
    if (len < 1) return;
    const ux = dx / len, uy = dy / len;
    const headLen = Math.max(8, width * 3);
    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2 - ux * headLen * 0.6, y2 - uy * headLen * 0.6);
    ctx.stroke();
    // 箭头头部
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - ux * headLen - uy * headLen * 0.4, y2 - uy * headLen + ux * headLen * 0.4);
    ctx.lineTo(x2 - ux * headLen + uy * headLen * 0.4, y2 - uy * headLen - ux * headLen * 0.4);
    ctx.closePath();
    ctx.fill();
    if (label) {
      ctx.font = 'bold 11px monospace';
      ctx.fillStyle = color;
      ctx.textBaseline = 'middle';
      const lx = x2 + ux * 8;
      const ly = y2 + uy * 8;
      ctx.fillText(label, lx, ly);
    }
    ctx.restore();
  }

  // ─── 二维可视化 ─────────────────────────────────────────────
  function init2D() {
    const svg = document.getElementById('viz2d');
    if (!svg) return;
    const W = 500, H = 400;
    const cx = W / 2, cy = H / 2;
    const scale = 140;

    const substances = [
