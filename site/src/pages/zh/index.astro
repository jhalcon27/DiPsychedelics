---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    slug: "how-does-it-feel-to-be-on-acid",
    title: "致幻剂（LSD）体验是什么样的？",
    subtitle: "意识状态的向量模型",
    excerpt: "一个利用三个轴（警觉性、参与度和神经熵）来绘制意识改变状态的框架。每种物质都是一个向量。",
    image: "/images/what-is-it-like-to-be-on-acid.jpg",
    imagePosition: "center",
    date: "2026-04-16",
    readTime: "14 分钟阅读",
    tags: ["意识", "致幻剂", "LSD", "心灵哲学"],
  },
  {
    slug: 'how-do-you-learn-to-change-an-insight-from-sorrow',
    title: '你如何学会改变？',
    subtitle: '从悲伤中得到的领悟',
    excerpt: '我相对较晚才察觉到自身的一种模式, , 晚到它已经造成了伤害。悲伤、身份认同与发展心理学如何在缓慢成为不同的人这一过程中交汇。',
    image: '/images/how-you-learn-to-change-from-sorrow.jpg',
    imagePosition: 'center',
    date: '2024-05-15',
    readTime: '4分钟阅读',
    tags: ['个人反思', '悲伤', '改变'],
  },
  {
    slug: 'neural-networks-physics-modifying-reality',
    title: '通往修改现实之路',
    subtitle: '神经网络、物理学与理论时间线',
    excerpt: '神经网络与物理学的融合开启了一条引人入胜的新路径：将AI推进到能够修改现实本身的可能性。',
    image: '/images/neural-networks.webp',
    imagePosition: 'center',
    date: '2025-06-15',
    readTime: '12分钟阅读',
    tags: ['神经网络', '物理学', '意识'],
  },
  {
    slug: 'digital-fabric-of-reality',
    title: '现实的数字结构',
    subtitle: '我们的意识本质上是数字化的吗？',
    excerpt: '探索意识和现实结构在本质上是数字化的这一深刻理念，以及这对我们理解存在意味着什么。',
    image: '/images/fabric-of-reality.jpeg',
    imagePosition: 'center',
    date: '2023-05-20',
    readTime: '7分钟阅读',
    tags: ['意识', '数字现实', '未来主义'],
  },
  {
    slug: 'mind-life-cosmos',
    title: '心智、生命与宇宙',
    subtitle: '相互连接的宇宙',
    excerpt: '探索宇宙、心智与我们在塑造意识和集体智能未来中所扮演角色之间的深刻关系。',
    image: '/images/mind-life-cosmos.webp',
    imagePosition: 'top',
    date: '2023-06-10',
    readTime: '6分钟阅读',
    tags: ['宇宙', '心智', '相互连接'],
  },
  {
    slug: 'fractality-of-organisation-and-emergence',
    title: '组织与涌现的分形性',
    subtitle: '泛心论在两个方向上都适用吗？',
    excerpt: '如果意识是有组织物质的一种属性，那么它是否一直延伸到电子，并上升到国家？状态耦合揭示了关于尺度内部的什么。',
    image: '/images/fractality-of-organisation-and-emergence.jpg',
    imagePosition: 'center',
    date: '2026-04-13',
    readTime: '8分钟阅读',
    tags: ['泛心论', '涌现', '意识', '复杂性'],
  },
];
---

<Layout
  title="数字迷幻 | 探索未来主义与虚拟现实"
  description="数字迷幻，Jho的个人博客，一位从工程师转型为银行家的人，探索物理学、意识与存在的本质。"
  lang="zh"
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-5 blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-5 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-cyber-cyan opacity-3 blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6 fade-in">
          <span class="cyber-tag">前沿思想</span>
          <span class="text-cyber-muted text-xs font-mono">// 探索数字意识</span>
        </div>

        <h1 class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6 fade-in" style="transition-delay: 0.1s">
          <span class="gradient-text">Digital</span><br/>
          <span class="text-cyber-text">Psychedelics</span>
        </h1>

        <p class="text-cyber-muted text-xl sm:text-2xl leading-relaxed mb-8 max-w-2xl fade-in" style="transition-delay: 0.2s">
          探索<span class="text-cyber-cyan">技术</span>、
          <span class="text-cyber-purple">意识</span>与人类体验未来的交汇点。
        </p>

        <p class="text-cyber-muted text-base leading-relaxed mb-10 max-w-xl fade-in" style="transition-delay: 0.3s">
          Jho的个人博客，一位从工程师转型为银行家的人，痴迷于存在本身的概念。探索物理学、意识以及存在的意义。
        </p>

        <div class="flex flex-wrap gap-4 fade-in" style="transition-delay: 0.4s">
          <a href="#featured" class="btn-cyber btn-cyber-filled">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            阅读文章
          </a>
          <a href="/zh/how-the-world-is-made" class="btn-cyber">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            神圣几何
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:flex flex-col items-center gap-2 text-cyber-muted text-xs fade-in" style="transition-delay: 0.6s">
      <span class="font-mono tracking-widest">向下滚动</span>
      <div class="w-px h-12 bg-gradient-to-b from-cyber-cyan to-transparent"></div>
    </div>
  </section>

  <div class="section-divider mx-8"></div>

  <!-- Featured Articles -->
  <section id="featured" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 fade-in">
        <div class="flex items-center gap-3 mb-3">
          <span class="cyber-tag">精选</span>
          <div class="h-px flex-1 bg-gradient-to-r from-cyber-cyan/30 to-transparent max-w-xs"></div>
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-cyber-text">
          最新<span class="gradient-text">传输</span>
        </h2>
        <p class="text-cyber-muted mt-2 max-w-lg">
          深度探索技术、意识与现实本质的交汇点。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articles.map((article, i) => (
          <article class="glass-card rounded-lg overflow-hidden fade-in" style={`transition-delay: ${i * 0.1}s`}>
            <div class="relative overflow-hidden h-48">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                style={`object-position: ${article.imagePosition}`}
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-cyber-dark/80 to-transparent"></div>
              <div class="absolute bottom-3 left-3 flex flex-wrap gap-1">
                {article.tags.slice(0, 2).map(tag => (
                  <span class="cyber-tag text-xs py-0.5">{tag}</span>
                ))}
              </div>
            </div>

            <div class="p-5">
              <div class="flex items-center gap-3 text-cyber-muted text-xs font-mono mb-3">
                <span>{article.readTime}</span>
              </div>
              <h3 class="font-display font-bold text-lg text-cyber-text mb-1 leading-tight">
                {article.title}
              </h3>
              <p class="text-cyber-cyan text-sm mb-3 font-medium">{article.subtitle}</p>
              <p class="text-cyber-muted text-sm leading-relaxed mb-4 line-clamp-3">
                {article.excerpt}
              </p>
              <a
                href={`/zh/blog/${article.slug}`}
                class="inline-flex items-center gap-2 text-cyber-cyan text-sm font-medium hover:gap-3 transition-all group"
              >
                阅读文章
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider mx-8"></div>

  <!-- About Section -->
  <section id="about" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="relative fade-in order-2 lg:order-1">
          <div class="relative rounded-xl overflow-hidden">
            <img src="/images/about.jpeg" alt="关于数字迷幻" class="w-full h-80 lg:h-96 object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tr from-cyber-dark/60 via-transparent to-cyber-purple/10"></div>
          </div>
        </div>
        <div class="fade-in order-1 lg:order-2" style="transition-delay: 0.2s">
          <div class="flex items-center gap-3 mb-4">
            <span class="cyber-tag">关于</span>
          </div>
          <h2 class="font-display font-bold text-3xl sm:text-4xl text-cyber-text mb-6">
            关于 <span class="gradient-text">数字迷幻</span>
          </h2>
          <div class="space-y-4 text-cyber-muted leading-relaxed">
            <p>数字迷幻是Jho的个人博客，一位从工程师转型为银行家的人，痴迷于存在本身的概念。该网站通过文章和互动内容探索物理学、意识与技术的交汇点。</p>
            <p>这里的问题是古老的：什么是意识？心智与物质的关系是什么？存在意味着什么？解决这些问题的工具是新的：神经科学、信息理论、人工智能和复杂性科学。</p>
            <p>没有确定的答案，只有诚实的探索。如果这些问题也让你彻夜难眠，那你来对地方了。</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/zh/contact" class="btn-cyber btn-cyber-filled">联系我们</a>
            <a href="#featured" class="btn-cyber">阅读文章</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
