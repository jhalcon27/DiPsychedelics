---
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

// Compute base path by stripping locale prefix
let basePath = Astro.url.pathname;
const locales = ['de', 'es', 'fr', 'zh', 'ja'];
for (const loc of locales) {
  if (basePath.startsWith(`/${loc}/`)) { basePath = basePath.slice(loc.length + 1); break; }
  if (basePath === `/${loc}` || basePath === `/${loc}/`) { basePath = '/'; break; }
}
if (!basePath.startsWith('/')) basePath = '/' + basePath;

const enHref = basePath;
const deHref = '/de' + (basePath === '/' ? '' : basePath);
const esHref = '/es' + (basePath === '/' ? '' : basePath);
const frHref = '/fr' + (basePath === '/' ? '' : basePath);
const zhHref = '/zh' + (basePath === '/' ? '' : basePath);
const jaHref = '/ja' + (basePath === '/' ? '' : basePath);

const labels: Record<string, string> = { en: 'EN', de: 'DE', es: 'ES', fr: 'FR', zh: '中文', ja: '日本語' };
const hrefs: Record<string, string> = { en: enHref, de: deHref, es: esHref, fr: frHref, zh: zhHref, ja: jaHref };
---

<div class="lang-switcher relative group" data-lang-switcher>
  <button
    class="lang-btn flex items-center gap-1.5 text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-mono px-2 py-1 rounded border border-transparent hover:border-cyber-cyan/30"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{labels[lang] ?? 'EN'}</span>
    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    class="lang-dropdown hidden absolute right-0 top-full mt-1 z-50 glass-card rounded-lg border border-cyber-border shadow-lg overflow-hidden min-w-[120px]"
  >
    {(['en', 'de', 'es', 'fr', 'zh', 'ja'] as const).map((loc) => (
      <a
        href={hrefs[loc]}
        class={`flex items-center gap-2 px-3 py-2 text-sm font-mono transition-colors hover:bg-cyber-cyan/10 hover:text-cyber-cyan ${lang === loc ? 'text-cyber-cyan bg-cyber-cyan/5' : 'text-cyber-muted'}`}
        aria-current={lang === loc ? 'page' : undefined}
      >
        <span>{labels[loc]}</span>
      </a>
    ))}
  </div>
</div>

<script>
  function initLangSwitchers() {
    const switchers = document.querySelectorAll('[data-lang-switcher]');
    
    switchers.forEach(switcher => {
      const btn = switcher.querySelector('.lang-btn');
      const dropdown = switcher.querySelector('.lang-dropdown');

      if (btn && dropdown) {
        const toggleDropdown = (open: boolean) => {
          if (open) {
            dropdown.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          } else {
            dropdown.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          }
        };

        const handleClick = (e: Event) => {
          e.stopPropagation();
          const isOpen = !dropdown.classList.contains('hidden');
          // Close all other switchers first
          document.querySelectorAll('.lang-dropdown').forEach(d => {
             if (d !== dropdown) d.classList.add('hidden');
          });
          toggleDropdown(!isOpen);
        };

        btn.addEventListener('click', handleClick);
      }
    });

    // Global close listener
    document.addEventListener('click', (e) => {
      const isInsideAny = (e.target as Element).closest('[data-lang-switcher]');
      if (!isInsideAny) {
        document.querySelectorAll('.lang-dropdown').forEach(d => d.classList.add('hidden'));
        document.querySelectorAll('.lang-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      }
    });
  }

  // Run on initial load
  initLangSwitchers();

  // Run on View Transitions navigation
  document.addEventListener('astro:after-swap', initLangSwitchers);
</script>
