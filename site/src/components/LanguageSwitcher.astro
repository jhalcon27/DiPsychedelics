---
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

// Compute base path by stripping locale prefix
let basePath = Astro.url.pathname;
const locales = ['de', 'es', 'zh', 'ja'];
for (const loc of locales) {
  if (basePath.startsWith(`/${loc}/`)) { basePath = basePath.slice(loc.length + 1); break; }
  if (basePath === `/${loc}` || basePath === `/${loc}/`) { basePath = '/'; break; }
}
if (!basePath.startsWith('/')) basePath = '/' + basePath;

const enHref = basePath;
const deHref = '/de' + (basePath === '/' ? '' : basePath);
const esHref = '/es' + (basePath === '/' ? '' : basePath);
const zhHref = '/zh' + (basePath === '/' ? '' : basePath);
const jaHref = '/ja' + (basePath === '/' ? '' : basePath);

const labels: Record<string, string> = { en: 'EN', de: 'DE', es: 'ES', zh: '中文', ja: '日本語' };
const hrefs: Record<string, string> = { en: enHref, de: deHref, es: esHref, zh: zhHref, ja: jaHref };
---

<div class="lang-switcher relative" id="lang-switcher">
  <button
    id="lang-btn"
    class="flex items-center gap-1.5 text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-mono px-2 py-1 rounded border border-transparent hover:border-cyber-cyan/30"
    aria-label="Select language"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>{labels[lang] ?? 'EN'}</span>
    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="hidden absolute right-0 top-full mt-1 z-50 glass-card rounded-lg border border-cyber-border shadow-lg overflow-hidden min-w-[120px]"
  >
    {(['en', 'de', 'es', 'zh', 'ja'] as const).map((loc) => (
      <a
        href={hrefs[loc]}
        class={`flex items-center gap-2 px-3 py-2 text-sm font-mono transition-colors hover:bg-cyber-cyan/10 hover:text-cyber-cyan ${lang === loc ? 'text-cyber-cyan bg-cyber-cyan/5' : 'text-cyber-muted'}`}
        aria-current={lang === loc ? 'page' : undefined}
      >
        <span>{labels[loc]}</span>
      </a>
    ))}
  </div>
</div>

<script>
  const btn = document.getElementById('lang-btn');
  const dropdown = document.getElementById('lang-dropdown');

  if (btn && dropdown) {
    let skipClose = false;

    btn.addEventListener('click', () => {
      skipClose = true;
      const isOpen = !dropdown.classList.contains('hidden');
      dropdown.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', () => {
      if (skipClose) { skipClose = false; return; }
      dropdown.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });

    dropdown.addEventListener('click', (e) => e.stopPropagation());
  }
</script>
