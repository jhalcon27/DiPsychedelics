---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { useTranslations, getOgLocale } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonicalURL?: string;
  lang?: string;
  article?: {
    publishedTime?: string;
    author?: string;
    tags?: string[];
  };
}

const {
  title,
  description = 'Digital Psychedelics is a personal blog by Jhonatan Serna, exploring physics, consciousness, simulation theory, and what it means to exist in a digital age.',
  image = '/images/fractality-of-organisation-and-emergence.jpg',
  type = 'website',
  canonicalURL = Astro.url.href,
  lang = 'en',
  article,
} = Astro.props;

const t = useTranslations(lang);

const siteURL = 'https://digitalpsychedelics.com';
const fullTitle = title.includes('Digital Psychedelics') ? title : `${title} | Digital Psychedelics`;
const ogLocale = getOgLocale(lang);

// Compute hreflang alternate URLs
let basePath = Astro.url.pathname;
if (basePath.startsWith('/de/')) basePath = basePath.slice(3);
else if (basePath === '/de' || basePath === '/de/') basePath = '/';
else if (basePath.startsWith('/es/')) basePath = basePath.slice(3);
else if (basePath === '/es' || basePath === '/es/') basePath = '/';
if (!basePath.startsWith('/')) basePath = '/' + basePath;

const enURL = `${siteURL}${basePath}`;
const deURL = `${siteURL}/de${basePath === '/' ? '' : basePath}`;
const esURL = `${siteURL}/es${basePath === '/' ? '' : basePath}`;

// Locale-aware link prefix for nav/footer
const prefix = lang === 'en' ? '' : `/${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Jhonatan Serna" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="digital consciousness, futurism, psychedelics, consciousness, physics, AI, sacred geometry, simulation hypothesis, Jhonatan Serna, digital psychedelics, technology and mind, quantum physics, neural networks, reality" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="de" href={deURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteURL}${image}`} />
    <meta property="og:site_name" content="Digital Psychedelics" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteURL}${image}`} />

    <!-- Article specific -->
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(
      type === 'article' && article ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": fullTitle,
        "description": description,
        "url": canonicalURL,
        "image": `${siteURL}${image}`,
        "datePublished": article.publishedTime,
        "author": {
          "@type": "Person",
          "name": article.author || "Jhonatan Serna",
          "url": siteURL
        },
        "publisher": {
          "@type": "Person",
          "name": "Jhonatan Serna",
          "url": siteURL
        }
      } : {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${siteURL}/#website`,
            "name": "Digital Psychedelics",
            "url": siteURL,
            "description": "An independent, ad-free platform exploring consciousness, technology, and the nature of reality.",
            "publisher": { "@id": `${siteURL}/#person` }
          },
          {
            "@type": "Person",
            "@id": `${siteURL}/#person`,
            "name": "Jhonatan Serna",
            "url": siteURL,
            "email": "strugen@proton.me",
            "description": "Engineer turned banker, obsessed with the concept of existence itself.",
            "jobTitle": "Author & Thought Leader",
            "sameAs": [
              "https://x.com/strugen_eth",
              "https://instagram.com/strugen",
              "https://app.ens.domains/strugen.eth"
            ]
          },
          {
            "@type": "WebPage",
            "@id": `${canonicalURL}#webpage`,
            "url": canonicalURL,
            "name": fullTitle,
            "description": description,
            "isPartOf": { "@id": `${siteURL}/#website` },
            "about": { "@id": `${siteURL}/#person` }
          }
        ]
      }
    )} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="d90bdf7d-b70d-49b4-88fe-0a4972a44af1"></script>
  </head>
  <body class="grid-bg min-h-screen">
    <!-- Scan line effect -->
    <div class="scanline"></div>

    <!-- Navigation -->
    <nav class="navbar-blur fixed top-0 left-0 right-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href={prefix + '/'} class="flex items-center gap-2 group">
            <div class="w-8 h-8 relative">
              <div class="absolute inset-0 rounded-full bg-gradient-to-br from-cyber-cyan to-cyber-purple opacity-20 group-hover:opacity-40 transition-opacity"></div>
              <svg viewBox="0 0 32 32" class="w-8 h-8" fill="none">
                <circle cx="16" cy="16" r="6" stroke="#00f0ff" stroke-width="1.5" opacity="0.8"/>
                <circle cx="16" cy="10" r="6" stroke="#00f0ff" stroke-width="1" opacity="0.4"/>
                <circle cx="21.2" cy="13" r="6" stroke="#b44aff" stroke-width="1" opacity="0.4"/>
                <circle cx="21.2" cy="19" r="6" stroke="#b44aff" stroke-width="1" opacity="0.3"/>
                <circle cx="16" cy="22" r="6" stroke="#00f0ff" stroke-width="1" opacity="0.3"/>
                <circle cx="10.8" cy="19" r="6" stroke="#00f0ff" stroke-width="1" opacity="0.3"/>
                <circle cx="10.8" cy="13" r="6" stroke="#b44aff" stroke-width="1" opacity="0.3"/>
              </svg>
            </div>
            <span class="font-display font-bold text-lg gradient-text hidden sm:block">Digital Psychedelics</span>
          </a>

          <!-- Desktop Nav -->
          <div class="hidden md:flex items-center gap-6">
            <a href={prefix + '/#featured'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium tracking-wide">{t.nav.blog}</a>
            <a href={prefix + '/how-the-world-is-made'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium tracking-wide">{t.nav.sacredGeometry}</a>
            <a href={prefix + '/#about'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium tracking-wide">{t.nav.about}</a>
            <a href={prefix + '/donate'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium tracking-wide">{t.nav.support}</a>
            <a href={prefix + '/contact'} class="btn-cyber text-xs py-2 px-4">{t.nav.contact}</a>
            <LanguageSwitcher lang={lang} />
          </div>

          <!-- Mobile: lang switcher + hamburger -->
          <div class="md:hidden flex items-center gap-2">
            <LanguageSwitcher lang={lang} />
            <button id="mobile-menu-btn" class="text-cyber-muted hover:text-cyber-cyan transition-colors p-2" aria-label={t.nav.toggleMenu}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Nav -->
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-cyber-border mt-2 pt-4">
          <div class="flex flex-col gap-4">
            <a href={prefix + '/#featured'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium">{t.nav.blog}</a>
            <a href={prefix + '/how-the-world-is-made'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium">{t.nav.sacredGeometry}</a>
            <a href={prefix + '/#about'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium">{t.nav.about}</a>
            <a href={prefix + '/donate'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium">{t.nav.support}</a>
            <a href={prefix + '/contact'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm font-medium">{t.nav.contact}</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyber-border mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <!-- Brand -->
          <div>
            <a href={prefix + '/'} class="flex items-center gap-2 mb-4">
              <span class="font-display font-bold text-lg gradient-text">Digital Psychedelics</span>
            </a>
            <p class="text-cyber-muted text-sm leading-relaxed">
              {t.footer.brandDesc}
            </p>
          </div>

          <!-- Links -->
          <div>
            <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">{t.footer.exploreLabel}</h3>
            <ul class="space-y-2">
              <li><a href={prefix + '/#featured'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm">{t.footer.articles}</a></li>
              <li><a href={prefix + '/how-the-world-is-made'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm">{t.footer.sacredGeometry}</a></li>
              <li><a href={prefix + '/#about'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm">{t.footer.about}</a></li>
              <li><a href={prefix + '/donate'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm">{t.footer.support}</a></li>
              <li><a href={prefix + '/contact'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm">{t.footer.contact}</a></li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">{t.footer.connectLabel}</h3>
            <ul class="space-y-2">
              <li>
                <a href="mailto:strugen@proton.me" class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  strugen@proton.me
                </a>
              </li>
              <li>
                <a href="https://instagram.com/strugen" target="_blank" rel="noopener noreferrer" class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm flex items-center gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                  @strugen
                </a>
              </li>
              <li>
                <a href={prefix + '/contact'} class="text-cyber-muted hover:text-cyber-cyan transition-colors text-sm flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                  {t.footer.getInTouch}
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="section-divider mb-6"></div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-cyber-muted text-xs">
            &copy; {new Date().getFullYear()} Digital Psychedelics. {t.footer.copyright}
          </p>
          <div class="flex items-center gap-1 text-cyber-muted text-xs">
            <span class="w-2 h-2 rounded-full bg-cyber-cyan pulse-glow inline-block"></span>
            <span>{t.footer.tagline}</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        menuIcon?.classList.toggle('hidden', !isOpen);
        closeIcon?.classList.toggle('hidden', isOpen);
      });

      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          menuIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        });
      });
    </script>

    <!-- Scroll animation observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
