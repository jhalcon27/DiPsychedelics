---
import Layout from './Layout.astro';
import { useTranslations, getLangCode } from '../i18n/index';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image: string;
  imagePosition?: string;
  date: string;
  readTime: string;
  tags: string[];
  author?: string;
  lang?: string;
  draft?: boolean;
}

const {
  title,
  subtitle,
  description,
  image,
  imagePosition = 'center',
  date,
  readTime,
  tags,
  author = 'Jhonatan Serna',
  lang = 'en',
  draft = false,
} = Astro.props;

const t = useTranslations(lang);
const langCode = getLangCode(lang);

const formattedDate = new Date(date).toLocaleDateString(langCode, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const prefix = lang === 'en' ? '' : `/${lang}`;
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  lang={lang}
  article={{
    publishedTime: date,
    author,
    tags,
  }}
>
  {draft && (
    <>
      <meta name="robots" content="noindex, nofollow" slot="head" />
      <div class="fixed top-0 left-0 right-0 z-50 bg-cyber-purple/90 text-white text-center text-xs font-mono py-1 tracking-widest uppercase">
        Draft, not published
      </div>
    </>
  )}
  <!-- Reading progress bar -->
  <div id="reading-progress" style="width: 0%"></div>

  <!-- Article Hero -->
  <section class="relative pt-8 pb-0 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-3 blur-3xl"></div>
      <div class="absolute top-0 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-3 blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-cyber-muted text-sm mb-8 font-mono">
        <a href={prefix + '/'} class="hover:text-cyber-cyan transition-colors">{t.article.home}</a>
        <span>/</span>
        <a href={prefix + '/#featured'} class="hover:text-cyber-cyan transition-colors">{t.article.blog}</a>
        <span>/</span>
        <span class="text-cyber-text truncate max-w-xs">{title}</span>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map(tag => (
          <span class="cyber-tag">{tag}</span>
        ))}
      </div>

      <!-- Title -->
      <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-cyber-text leading-tight mb-4">
        {title}
      </h1>

      {subtitle && (
        <p class="text-cyber-cyan text-xl font-medium mb-6">{subtitle}</p>
      )}

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 text-cyber-muted text-sm font-mono mb-8 pb-8 border-b border-cyber-border">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span>{author}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>{formattedDate}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{readTime}</span>
        </div>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-0">
      <div class="relative rounded-xl overflow-hidden">
        <img
          src={image}
          alt={title}
          class="w-full h-64 sm:h-80 lg:h-96 object-cover"
          style={`object-position: ${imagePosition}`}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-cyber-dark/60 via-transparent to-transparent"></div>
        <div class="absolute inset-0 rounded-xl border border-cyber-cyan/10 pointer-events-none"></div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-12">
        <!-- Main content -->
        <div class="prose-cyber">
          <slot />
        </div>

        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-6">
            <!-- Author card -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">{t.article.author}</h3>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full overflow-hidden border border-cyber-cyan/20">
                  <img src="/images/profile_pic.jpg" alt={author} class="w-full h-full object-cover" />
                </div>
                <div>
                  <p class="text-cyber-text text-sm font-medium">{author}</p>
                  <p class="text-cyber-muted text-xs">{t.article.futuristRole}</p>
                </div>
              </div>
              <a href={prefix + '/contact'} class="btn-cyber text-xs py-2 px-3 w-full justify-center mt-3">
                {t.article.getInTouch}
              </a>
            </div>

            <!-- Tags -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">{t.article.topics}</h3>
              <div class="flex flex-wrap gap-2">
                {tags.map(tag => (
                  <span class="cyber-tag">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Share -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">{t.article.share}</h3>
              <div class="flex flex-col gap-2">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-cyber text-xs py-2 px-3 justify-center"
                >
                  𝕏 &nbsp;Twitter / X
                </a>
                <a
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-cyber text-xs py-2 px-3 justify-center"
                >
                  Facebook
                </a>
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-cyber text-xs py-2 px-3 justify-center"
                >
                  WhatsApp
                </a>
                <button
                  id="copy-link-btn"
                  class="btn-cyber text-xs py-2 px-3 justify-center w-full"
                  data-url={Astro.url.href}
                >
                  Copy link
                </button>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Comments -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-divider mb-8"></div>
      <h2 class="text-cyber-text font-display font-bold text-2xl mb-8">{t.article.comments}</h2>
      <div class="giscus-container">
        <script
          src="https://giscus.app/client.js"
          data-repo="jhalcon27/DiPsychedelics"
          data-repo-id="MDEwOlJlcG9zaXRvcnkyMjkyNjcxMzk="
          data-category="Announcements"
          data-category-id="DIC_kwDODapWw84C6z-i"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="preferred_color_scheme"
          data-lang={lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        ></script>
      </div>
      <p class="text-cyber-muted text-sm mt-6 font-mono">
        {t.article.aiCommentNote}
      </p>
    </div>
  </section>

  <!-- Back to blog -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-divider mb-8"></div>
      <a href={prefix + '/#featured'} class="inline-flex items-center gap-2 text-cyber-cyan hover:gap-3 transition-all group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        {t.article.backToAll}
      </a>
    </div>
  </section>

  <!-- Copy link script -->
  <script>
    const copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        navigator.clipboard.writeText(url).then(() => {
          const orig = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = orig; }, 2000);
        });
      });
    }
  </script>

  <!-- Reading progress script -->
  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.prose-cyber');

    if (progressBar && article) {
      const updateProgress = () => {
        const articleTop = (article as HTMLElement).offsetTop;
        const articleHeight = (article as HTMLElement).offsetHeight;
        const windowHeight = window.innerHeight;
        const scrolled = window.scrollY;

        const progress = Math.min(
          Math.max((scrolled - articleTop + windowHeight * 0.5) / articleHeight, 0),
          1
        );

        progressBar.style.width = `${progress * 100}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  </script>
</Layout>
