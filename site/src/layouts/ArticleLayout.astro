---
import Layout from './Layout.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image: string;
  date: string;
  readTime: string;
  tags: string[];
  author?: string;
}

const {
  title,
  subtitle,
  description,
  image,
  date,
  readTime,
  tags,
  author = 'Jhonatan Serna',
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  article={{
    publishedTime: date,
    author,
    tags,
  }}
>
  <!-- Reading progress bar -->
  <div id="reading-progress" style="width: 0%"></div>

  <!-- Article Hero -->
  <section class="relative pt-8 pb-0 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full bg-cyber-cyan opacity-3 blur-3xl"></div>
      <div class="absolute top-0 right-1/4 w-96 h-96 rounded-full bg-cyber-purple opacity-3 blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-cyber-muted text-sm mb-8 font-mono">
        <a href="/" class="hover:text-cyber-cyan transition-colors">Home</a>
        <span>/</span>
        <a href="/#featured" class="hover:text-cyber-cyan transition-colors">Blog</a>
        <span>/</span>
        <span class="text-cyber-text truncate max-w-xs">{title}</span>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map(tag => (
          <span class="cyber-tag">{tag}</span>
        ))}
      </div>

      <!-- Title -->
      <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-cyber-text leading-tight mb-4">
        {title}
      </h1>

      {subtitle && (
        <p class="text-cyber-cyan text-xl font-medium mb-6">{subtitle}</p>
      )}

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 text-cyber-muted text-sm font-mono mb-8 pb-8 border-b border-cyber-border">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span>{author}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>{formattedDate}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{readTime}</span>
        </div>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-0">
      <div class="relative rounded-xl overflow-hidden">
        <img
          src={image}
          alt={title}
          class="w-full h-64 sm:h-80 lg:h-96 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-cyber-dark/60 via-transparent to-transparent"></div>
        <!-- Neon border effect -->
        <div class="absolute inset-0 rounded-xl border border-cyber-cyan/10 pointer-events-none"></div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-12">
        <!-- Main content -->
        <div class="prose-cyber">
          <slot />
        </div>

        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-6">
            <!-- Author card -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">Author</h3>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full overflow-hidden border border-cyber-cyan/20">
                  <img src="/images/profile_pic.jpg" alt={author} class="w-full h-full object-cover" />
                </div>
                <div>
                  <p class="text-cyber-text text-sm font-medium">{author}</p>
                  <p class="text-cyber-muted text-xs">Futurist & Writer</p>
                </div>
              </div>
              <a href="/contact" class="btn-cyber text-xs py-2 px-3 w-full justify-center mt-3">
                Book a Lecture
              </a>
            </div>

            <!-- Tags -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">Topics</h3>
              <div class="flex flex-wrap gap-2">
                {tags.map(tag => (
                  <span class="cyber-tag">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Share -->
            <div class="glass-card rounded-lg p-5">
              <h3 class="text-cyber-text font-semibold text-sm uppercase tracking-widest mb-4">Share</h3>
              <div class="flex gap-3">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 btn-cyber text-xs py-2 px-3 justify-center"
                >
                  Twitter
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 btn-cyber text-xs py-2 px-3 justify-center"
                >
                  LinkedIn
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Back to blog -->
  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-divider mb-8"></div>
      <a href="/#featured" class="inline-flex items-center gap-2 text-cyber-cyan hover:gap-3 transition-all group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        Back to all articles
      </a>
    </div>
  </section>

  <!-- Reading progress script -->
  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('.prose-cyber');

    if (progressBar && article) {
      const updateProgress = () => {
        const articleTop = (article as HTMLElement).offsetTop;
        const articleHeight = (article as HTMLElement).offsetHeight;
        const windowHeight = window.innerHeight;
        const scrolled = window.scrollY;

        const progress = Math.min(
          Math.max((scrolled - articleTop + windowHeight * 0.5) / articleHeight, 0),
          1
        );

        progressBar.style.width = `${progress * 100}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  </script>
</Layout>
